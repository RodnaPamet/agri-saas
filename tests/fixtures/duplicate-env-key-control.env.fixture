# The real-file positive control for the env-template half of
# `no-duplicate-object-keys` — #2537. Do not "fix" the duplicate below.
#
# A dotenv loader keeps the LAST assignment, so a duplicate here means the
# first value is dead and the file reads as though it set it. Six templates in
# the repo carry 129 keys between them and zero duplicates, so this file is the
# only thing that can prove the extractor still matches anything.
DATABASE_URL=postgresql://user@localhost:5432/db
AV_SCAN_MODE=enforce
REDIS_URL=redis://localhost:6379
# exported form, which a naive `^KEY=` pattern misses
export PLATFORM_TENANT_SLUG=acme
AV_SCAN_MODE=permissive
# a value that merely CONTAINS an = must not be read as a second key
SMTP_OPTS=user=a;pass=b
#   indented comments and blank lines are not keys

   # a commented-out assignment is not a key
   # AV_SCAN_MODE=off
