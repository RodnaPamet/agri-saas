/**
 * The real-file positive control for the IMPORT half of
 * `no-duplicate-declarations` — #2554.
 *
 * ## Why this is not a `.ts` file
 *
 * It contains deliberate TS2300 errors. Measured with `tsc --listFilesOnly`,
 * all 2,466 `.ts`/`.tsx` files under `tests/` are in the program, so a real
 * duplicate identifier here would redden the required `Typecheck` job. The
 * `.fixture` extension keeps tsc out while the guard parses it through the
 * SAME walk, with an explicit `ScriptKind.TS`.
 *
 * ## Every row below was measured, not reasoned
 *
 * Six two-file probes under `tsc --noEmit`:
 *
 *   import { a } from "./mod"; import { a } from "./mod";           TS2300
 *   import { a } from "./mod"; import { b } from "./mod";           exit 0
 *   import type { T } from "./mod"; import { a } from "./mod";      exit 0
 *   import type { a } from "./mod"; import { a } from "./mod";      TS2300
 *   import { a as z } from "./mod"; import { b as z } from "./mod"; TS2300
 *   import { a as z } from "./mod"; import { b as y } from "./mod"; exit 0
 *
 * So the rule is the LOCAL BINDING NAME and nothing else. `import type` buys
 * no exemption (row 4), two imports from one module are legal when the
 * bindings differ (rows 2 and 3), and a collision does not require the same
 * module at all — which is why keying on the specifier would be wrong in both
 * directions.
 *
 * **Do not "fix" the duplicates below.** They are the control, and the guard
 * asserts both that they are REPORTED and that the legal rows are NOT.
 */

// ── MUST be reported ────────────────────────────────────────────────────────

// The #2554 shape: both branches added the same import at different offsets,
// git took both, and only the cold typecheck noticed.
import { EXCHANGE_CURRENCY } from './money';
import { formatCents } from './money';
import { EXCHANGE_CURRENCY } from './money';

// Type-ness buys nothing: the same local name, one of them type-only.
import type { Tenant } from './models';
import { Tenant } from './models';

// Two aliases onto one local name — and from DIFFERENT modules, which a
// specifier-keyed detector would never pair.
import { alpha as shared } from './first';
import { beta as shared } from './second';

// A default and a named binding colliding on one local name.
import logger from './logger';
import { logger } from './logging';

// ── MUST NOT be reported ────────────────────────────────────────────────────

// Two imports from one module with DIFFERENT bindings — legal, common, and the
// shape that would get this guard baselined if it were flagged.
import { readFile } from './fs-helpers';
import { writeFile } from './fs-helpers';

// A type-only import beside a value import, different names — the pair that
// prompted the question.
import type { Parcel } from './land';
import { parcelArea } from './land';

// Aliased APART: the locals differ, so this passes for the same reason
// TypeScript accepts it, not through a carve-out.
import { gamma as first } from './greek';
import { delta as second } from './greek';

// A namespace import beside a named one.
import * as path from './path-utils';
import { join } from './path-utils';

// `export … from` introduces NO local binding, so it is out of scope — a
// re-export collision is a different question with a different answer.
export { EXCHANGE_CURRENCY as CURRENCY } from './money';

export const used = [
    EXCHANGE_CURRENCY, formatCents, Tenant, shared, logger,
    readFile, writeFile, parcelArea, first, second, path, join,
];
export type Used = Parcel;
