      "enum": [
        "exact",
        "atLeast",
        "atMost",
        "allocated",
        "partial",
        "refused"
      ]
    },
    "costCurrencyCodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rentCurrencyUnknown": {
      "type": "boolean"
    },
    "showProduceRent": {
      "type": "boolean"
    },
    "costBreakdown": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/CalculatorCostSlice"
      }
    }
  },
  "required": [
    "commodity",
    "pricePerTonne",
    "priceCurrency",
    "priceObservedAt",
    "priceSource",
    "standingCropAreaHa",
    "standingCropExpectedKg",
    "standingCropValue",
    "perArea",
    "breakEven",
    "grainOnHandTonnes",
    "grainOnHandValue",
    "rentCostProduceKg",
    "rentCostProduceValue",
    "payrollAllocated",
    "cashCostTotal",
    "unvaluedNoUnitCost",
    "unvaluedUnitMismatch",
    "netWorth",
    "netWorthUnavailableReason",
    "netWorthUnavailableCode",
    "netWorthUnavailableParams",
    "netUncertainty",
    "costUncertainty",
    "costCurrencyCodes",
    "rentCurrencyUnknown",
    "showProduceRent",
    "costBreakdown"
  ],
  "description": "One commodity’s net-worth answer. Figures are accompanied by an uncertainty state rather than presented bare: netUncertainty and costUncertainty say whether a number is exact, a floor, a ceiling, apportioned, partial or refused. A refused net worth carries a CODE to translate and English to fall back to."
}"
`;

