          "type": "array",
          "items": {
            "$ref": "#/components/schemas/CalculatorFarmTotal"
          }
        },
        "refusedWithoutCurrency": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "totals",
        "refusedWithoutCurrency"
      ]
    },
    "exclusions": {
      "$ref": "#/components/schemas/CalculatorExclusions"
    },
    "unvalued": {
      "type": "object",
      "properties": {
        "noUnitCost": {
          "type": "number"
        },
        "unitMismatch": {
          "type": "number"
        }
      },
      "required": [
        "noUnitCost",
        "unitMismatch"
      ]
    },
    "cashOut": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/CalculatorCashOutLine"
      }
    },
    "unallocatedToCrop": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number"
        },
        "areaHa": {
          "type": "number"
        },
        "parcelIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "currencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "amount",
        "areaHa",
        "parcelIds",
        "currencies"
      ]
    },
    "imputedLandCharge": {
      "$ref": "#/components/schemas/CalculatorImputedLandCharge"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "generatedAt",
    "seasonId",
    "rows",
    "farm",
    "exclusions",
    "unvalued",
    "cashOut",
    "unallocatedToCrop",
    "imputedLandCharge",
    "truncated"
  ],
  "description": "The grain net-worth calculator’s whole answer. Every figure is a number, string, boolean or array thereof — no Decimal and no Date crosses this boundary. Read \`truncated\` before trusting a total: when it is true the figures cover only part of the farm. Read \`unallocatedToCrop\` too — the per-commodity rows are short by exactly that amount, so a client showing only rows displays a cost that shrinks when the farmer changes how it spreads."
}"
`;

