exports[`API contract — per-schema snapshots schema: AuditLogEntry 1`] = `
"{
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "example": "CONTROL_CREATED"
    },
    "entity": {
      "type": "string",
      "example": "Control"
    },
    "entityId": {
      "type": "string"
    },
    "details": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "example": "2026-04-28T07:42:11.000Z"
    },
    "user": {
      "allOf": [
        {
          "$ref": "#/components/schemas/UserRefShort"
        },
        {
          "type": [
            "object",
            "null"
          ]
        }
      ]
    }
  },
  "required": [
    "id",
    "action",
    "details",
    "createdAt"
  ],
  "additionalProperties": {},
  "description": "A single audit-log row. Hash-chained at the DB layer; this DTO is the read view exposed via the audit/activity endpoints."
}"
`;

