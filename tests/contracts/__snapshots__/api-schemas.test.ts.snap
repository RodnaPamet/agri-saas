exports[`API contract — per-schema snapshots schema: FieldOperationCreated 1`] = `
"{
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string"
    },
    "taskKey": {
      "type": [
        "string",
        "null"
      ],
      "description": "The human \`TSK-N\` handle."
    },
    "locationId": {
      "type": "string"
    },
    "parcelCount": {
      "type": "integer",
      "description": "Lines written. \`0\` is the tell of a PARTIALLY COMMITTED create: the Task exists but has no location link, no operationType and no lines, and nothing can add them afterwards. It is also the discriminator the idempotent-replay check uses, so a replay only short-circuits on a job that really landed."
    }
  },
  "required": [
    "taskId",
    "taskKey",
    "locationId",
    "parcelCount"
  ],
  "description": "Identity of the spray job that was created."
}"
`;

exports[`API contract — per-schema snapshots schema: FieldOperationDetail 1`] = `
"{
  "type": "object",
  "properties": {
    "task": {
      "$ref": "#/components/schemas/Task"
    },
    "lines": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/OperationParcel"
      }
    },
    "location": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "boundsJson": {}
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": {},
      "description": "Resolved through the Task↔Location TaskLink. NULL when the job has no location link — which is exactly what a partially-committed create leaves behind, so a null here is a signal, not just an absence."
    },
    "parcels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "additionalProperties": {}
      },
      "description": "Every parcel of the linked location (for the map backdrop) — NOT only the parcels this job prescribes. The prescribed set is \`lines\`. Empty when \`location\` is null."
    },
    "progress": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "description": "Number of prescription lines."
        },
        "done": {
          "type": "integer",
          "description": "Lines that are DONE **or SKIPPED** — a skip counts as progress."
        }
      },
      "required": [
        "total",
        "done"
      ],
      "description": "Derived from \`lines\`; not stored."
    }
  },
  "required": [
    "task",
    "lines",
    "location",
    "parcels",
    "progress"
  ],
  "description": "One spray job: the Task, its per-parcel prescription lines, the linked location with all of its parcels for the map, and a derived progress counter."
}"
`;

