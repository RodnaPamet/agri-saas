    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationMs": {
      "type": "number"
    },
    "itemsScanned": {
      "type": "number"
    },
    "itemsActioned": {
      "type": "number"
    },
    "itemsSkipped": {
      "type": "number"
    },
    "errorMessage": {
      "type": "string"
    },
    "details": {
      "description": "Per-job payload. For \`spatial-import\` it carries \`tenantId\`, \`locationId\`, \`fileRecordId\`, \`format\`, \`bounds\`, \`jobRunId\`, \`parcelCount\` and the reconciliation counts \`matched\` / \`created\` / \`flagged\` — see \`SpatialImportDetails\`. Other job names carry their own keys."
    }
  },
  "required": [
    "jobName",
    "jobRunId",
    "success",
    "startedAt",
    "completedAt",
    "durationMs",
    "itemsScanned",
    "itemsActioned",
    "itemsSkipped"
  ],
  "description": "The worker’s return value once \`state\` is completed. NULL until then — poll until \`state\` is \`completed\` rather than treating a null result as a failure."
}"
`;

