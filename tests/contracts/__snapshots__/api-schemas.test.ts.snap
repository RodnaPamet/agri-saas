        "message": {
          "type": "string",
          "example": "Practice not found"
        },
        "requestId": {
          "type": "string",
          "example": "req_01HG7…"
        },
        "details": {}
      },
      "required": [
        "code",
        "message"
      ]
    }
  },
  "required": [
    "error"
  ],
  "description": "A 409 from the optimistic lock. \`error.details.currentVersion\` carries the version the server holds — read it from \`error.details\`, NOT from the body root. A client that treats this as success loses the operator’s edit (#921/#922)."
}"
`;

