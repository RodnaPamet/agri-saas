exports[`API contract — per-schema snapshots schema: FarmRecordGenerateRequest 1`] = `
"{
  "type": "object",
  "properties": {
    "from": {
      "type": "string",
      "minLength": 1
    },
    "to": {
      "type": "string",
      "minLength": 1
    },
    "save": {
      "type": "boolean",
      "default": false,
      "description": "THE MEDIA TYPE SWITCH. Omitted or false → the response is \`application/pdf\` bytes. True → it is \`application/json\` \`{ fileRecordId, fileName }\` and the PDF is filed in the location’s Farm-records register instead of being returned."
    }
  },
  "required": [
    "from",
    "to"
  ],
  "description": "Mirrors the schema declared inside the farm-record route handler."
}"
`;

