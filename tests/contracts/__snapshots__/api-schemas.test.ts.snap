    "siltPct",
    "clayPct",
    "phH2o",
    "socGkg",
    "bulkDensity",
    "depth",
    "provider",
    "fetchedAt"
  ],
  "description": "A parcel’s modelled soil profile, fetched asynchronously — null upstream while the fetch is pending, which is an ordinary state rather than an error."
}"
`;

exports[`API contract — per-schema snapshots schema: SoilSuitability 1`] = `
