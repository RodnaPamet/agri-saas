      "$ref": "#/components/schemas/GrainBin"
    },
    {
      "type": "object",
      "properties": {
        "lots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "lotCode": {
                "type": "string"
              },
              "itemName": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              },
              "unitSymbol": {
                "type": "string"
              },
              "expiresAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "attributes": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": {}
              }
            },
            "required": [
              "id",
              "lotCode",
              "itemName",
              "quantity",
              "unitSymbol",
              "expiresAt",
              "attributes"
            ]
          }
        },
        "lotsTruncated": {
          "type": "boolean"
        }
      },
      "required": [
        "lots",
        "lotsTruncated"
      ],
      "additionalProperties": {}
    }
  ],
  "description": "A bin with its stored lots. lotsTruncated is a real truncation marker — a rarity in this API — so a lot count taken from \`lots.length\` is wrong when it is true; use \`lotCount\`."
}"
`;

