exports[`API contract — per-schema snapshots schema: AcceptTermsRequest 1`] = `
"{
  "type": "object",
  "properties": {
    "acceptedTerms": {
      "type": "boolean",
      "enum": [
        true
      ],
      "description": "Must be literally true. Absent or false is 400 terms_not_accepted."
    },
    "termsVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "example": "2026-10-07-draft",
      "description": "The version the client DISPLAYED. Compared for equality with the one being served, so a page left open across a terms change cannot file a consent to a document nobody read."
    }
  },
  "required": [
    "acceptedTerms",
    "termsVersion"
  ]
}"
`;

