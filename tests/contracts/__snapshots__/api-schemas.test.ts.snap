exports[`API contract — per-schema snapshots schema: CalculatorData 1`] = `
"{
  "type": "object",
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "seasonId": {
      "type": [
        "string",
        "null"
      ]
    },
