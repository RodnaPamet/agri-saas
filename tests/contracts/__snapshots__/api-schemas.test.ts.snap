exports[`API contract — per-schema snapshots schema: ExchangeThread 1`] = `
"{
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "listingId": {
      "type": "string"
    },
    "listingCommodity": {
      "type": "string"
    },
