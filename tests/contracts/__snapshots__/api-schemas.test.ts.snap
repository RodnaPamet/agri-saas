      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20000
    },
    "quantities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "measure": {
            "type": "string",
            "enum": [
              "COUNT",
              "WEIGHT",
              "VOLUME",
              "AREA",
              "LENGTH",
              "RATE",
              "OTHER"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unitId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          }
        },
        "required": [
          "measure",
          "value",
          "unitId"
        ]
      },
      "maxItems": 50
    },
    "locationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    },
    "equipmentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    },
    "operationParcelId": {
      "type": [
        "string",
        "null"
      ]
    },
    "costAmount": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "costCurrency": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8
    },
    "harvest": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lotCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "locationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "parcelId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceLotIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 100
        },
        "costAmount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "costCurrency": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8
        },
        "recordYield": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "itemId",
        "quantity"
      ]
    },
    "plantingLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "plantingId": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "enum": [
              "SOW",
              "TRANSPLANT",
              "HARVEST"
            ]
          }
        },
        "required": [
          "plantingId",
          "stage"
        ]
      },
      "maxItems": 100
    }
  },
  "required": [
    "type",
    "title"
  ],
  "description": "Create a field-journal entry (LogEntry). title is sanitized as plain text; notes is sanitized as rich-text HTML (TipTap). quantities carry the farmOS measure+value+unit lines (an INPUT_APPLICATION entry records the applied amount); locationIds / equipmentIds link the entry to field blocks and equipment. occurredAt defaults to now. plantingLinks record plan-vs-actual: each links the entry to a Planting + lifecycle stage (SOW/TRANSPLANT/HARVEST), writing a LogPlanting row (the entry becomes the ACTUAL for that milestone) and advancing the Planting status. On a HARVEST entry, an optional harvest payload mints a HARVEST_IN inventory lot of the harvested item and records lot genealogy (the input lots consumed on parcelId become DERIVATION parents)."
}"
`;

