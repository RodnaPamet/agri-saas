exports[`API contract — per-schema snapshots schema: BottomTabOrder 1`] = `
"{
  "type": [
    "array",
    "null"
  ],
  "items": {
    "type": "string"
  },
  "maxItems": 12,
  "description": "Ordered tenant-relative route suffixes — \`/dashboard\`, \`/farm-tasks\`, \`/grain/costs\`. Validated for SHAPE only: up to 12 unique non-empty strings, never against a list of known tabs, so a tab shipped by a newer client saves against an older server. It is a PREFERENCE, not a grant — resolve it against the surfaces the member may actually reach on EVERY render, because a role can change after the write. \`null\` and \`[]\` are different states (see schema).",
  "example": [
    "/dashboard",
    "/farm-tasks",
    "/locations",
    "/journal",
    "/exchange"
  ]
}"
`;

