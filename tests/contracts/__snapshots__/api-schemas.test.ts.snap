      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "year",
    "cropType",
    "sownAt",
    "harvestedAt",
    "notes"
  ],
  "description": "\`year\` is the HARVEST year. Do not derive it from \`sownAt\`: wheat sown in October 2025 is the 2026 harvest, so deriving would misfile most autumn cropping by one year. \`sownAt\` is optional — a back-filled season is often remembered without the drilling date."
}"
`;

exports[`API contract — per-schema snapshots schema: ParcelGeo 1`] = `
"{
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "cropType": {
      "type": [
        "string",
        "null"
      ]
    },
    "areaHa": {
      "type": [
        "number",
        "null"
      ],
      "description": "On-ellipsoid hectares, computed in PostGIS. A NUMBER here, unlike the STRING on an OperationParcel line."
    },
    "geometry": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "MultiPolygon"
          ]
        },
        "coordinates": {
          "type": "array",
          "items": {},
          "description": "Nested coordinate arrays, as GeoJSON nests them — \`[[[lon, lat], …]]\` for a Polygon, one level deeper for a MultiPolygon. Left unconstrained here rather than modelled to four levels, which no generator handles usefully."
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": {},
      "description": "GeoJSON geometry, WGS84. Simplified when the read passed \`?simplify=\` — never for sketch/edit, which needs exact geometry.\\n\\n**Null is reachable and is not an error.** A simplify tolerance large enough to collapse a small parcel returns null rather than a degenerate shape, so a client must handle a parcel it cannot draw. Re-read without \`?simplify=\` to get the exact geometry."
    },
    "properties": {},
    "cadastralId": {
      "type": [
        "string",
        "null"
      ],
      "description": "КАИС identifier \`ЕКАТТЕ.масив.парцел\`; null when not linked."
    },
    "ekatte": {
      "type": [
        "string",
        "null"
      ],
      "description": "5-digit settlement prefix of \`cadastralId\`."
    },
    "soilType": {
      "type": [
        "string",
        "null"
      ],
      "description": "Modelled soil label. Null while the async SoilGrids fetch is still pending."
    },
    "soilJson": {},
    "absentFromImportAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "When the location’s LAST spatial import did not contain this parcel — it was kept, with all of its history, and marked. Null means it WAS in the last import, or that the location has never been imported into; both mean nothing to warn about. A TIMESTAMP rather than a boolean because \\"not in the last import\\" and \\"not in any import since March\\" are different facts and only the first is actionable — compare it against the location’s last import."
    },
    "companyOwners": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "eik": {
            "type": "string"
          },
          "rightType": {
            "type": [
              "string",
              "null"
            ]
          },
          "subjectKind": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "eik",
          "rightType",
          "subjectKind"
        ]
      },
      "description": "LEGAL-ENTITY owners from the КАИС register, joined at read time on \`cadastralId\`. Physical persons are never stored, so an individually-owned parcel has an EMPTY array — that is not \\"unknown owner\\"."
    },
    "hasActiveLease": {
      "type": "boolean",
      "description": "A non-deleted lease with no end date, or an end date in the future."
    }
  },
  "required": [
    "id",
    "name",
    "cropType",
    "areaHa",
    "geometry",
    "cadastralId",
    "ekatte",
    "soilType",
    "absentFromImportAt",
    "companyOwners",
    "hasActiveLease"
  ],
  "additionalProperties": {},
  "description": "A parcel as the map and the parcel list receive it — geometry as GeoJSON plus the soil and land-administration columns. Wider than the \`Parcel\` DTO, which describes the \`LocationDetail\` shape."
}"
`;

