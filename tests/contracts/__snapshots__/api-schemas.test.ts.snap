        {
          "$ref": "#/components/schemas/MarketReference"
        },
        {
          "type": [
            "object",
            "null"
          ]
        }
      ]
    }
  },
  "required": [
    "status",
    "deltaPerTonne",
    "deltaPct",
    "reference"
  ],
  "additionalProperties": {},
  "description": "Whether this contract is priced above or below market, or why it could not be compared. Deltas are present only when status is OK."
}"
`;

exports[`API contract — per-schema snapshots schema: ContractBookTotal 1`] = `
"{
  "type": "object",
