exports[`API contract — per-schema snapshots schema: ParcelClusterOverview 1`] = `
"{
  "type": "object",
  "properties": {
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Hash of the SORTED member ids, not of the grid cell — so a cluster id in a shared URL resolves to the same parcels, and only changes when the membership genuinely differs."
          },
          "lon": {
            "type": "number"
          },
          "lat": {
            "type": "number"
          },
          "count": {
            "type": "integer"
          },
          "parcelIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "totalAreaHa": {
            "type": "number"
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "description": "Nearest settlement name."
          }
        },
        "required": [
          "id",
          "lon",
          "lat",
          "count",
          "parcelIds",
          "totalAreaHa",
          "label"
        ]
      }
    },
    "parcels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "lon": {
            "type": "number"
          },
          "lat": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "lon",
          "lat"
        ]
      },
      "description": "Every POSITIONED parcel, so the view can switch from clusters to parcels once zoomed in — the cluster grid bottoms out at 200 m and cannot separate them."
    },
    "bbox": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "Bounding box as \`[west, south, east, north]\` — \`[minLon, minLat, maxLon, maxLat]\`, **longitude first**, per GeoJSON and the reverse of the \`lat, lon\` a human quotes. WGS84 degrees, exactly four numbers. Covers the POSITIONED parcels only — a location whose parcels all lack geometry contributes nothing to it."
    },
    "positionedCount": {
      "type": "integer"
    },
    "unpositionedCount": {
      "type": "integer",
      "description": "Parcels with NULL geometry. Never folded into the total: a holding whose map silently omits 30 fields is data loss the farmer cannot see."
    },
    "unpositionedParcelIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "truncated": {
      "type": "boolean",
      "description": "The read hit its 2000-parcel bound; this is a subset."
    }
  },
  "required": [
