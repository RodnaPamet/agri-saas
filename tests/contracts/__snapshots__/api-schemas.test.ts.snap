exports[`API contract — per-schema snapshots schema: AdminMember 1`] = `
"{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The MEMBERSHIP id — this is what every other operation here takes, not the user id."
    },
    "tenantId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "description": "The enum role. A growing union — treat an unrecognised value as the least privilege rather than as an error. When \`customRole\` is set, THIS field is the base and the custom role overrides it."
    },
    "customRoleId": {
      "type": [
        "string",
        "null"
      ]
    },
    "customRole": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "description": "Granular overrides on top of \`role\`. Null for the great majority of members."
    },
    "status": {
      "type": "string",
      "description": "\`ACTIVE\`, \`INVITED\` or \`DEACTIVATED\`. **Load-bearing, not decoration** — this list deliberately includes deactivated members. \`REMOVED\` never appears: that status exists so the row leaves this list."
    },
    "invitedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "invitedByUserId": {
      "type": [
        "string",
        "null"
      ]
    },
    "invitedBy": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "deactivatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "applicatorCertNo": {
      "type": [
        "string",
        "null"
      ],
      "description": "БАБХ plant-protection applicator certificate. Written by the \`certificates\` PUT, not by role edits."
    },
    "agronomistCertNo": {
      "type": [
        "string",
        "null"
      ]
    },
    "agronomistName": {
      "type": [
        "string",
        "null"
      ]
    },
    "provisionedByOrgId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Set when the membership came from an organisation provisioning run rather than a manual invite."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "user": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "type": "string"
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "image",
        "createdAt"
      ]
    },
    "activeSessionCount": {
      "type": "integer",
      "description": "Live sessions for this member. **A best-effort figure: \`0\` means \\"none\\" OR \\"the session store could not be read\\".** The read is wrapped so a failure degrades the page rather than failing it, and the degraded value is 0 for every member. Render it as a fact only if that ambiguity is acceptable; prefer showing nothing at 0."
    }
  },
  "required": [
    "id",
    "tenantId",
    "userId",
    "role",
    "customRoleId",
    "customRole",
    "status",
    "invitedAt",
    "invitedByUserId",
    "invitedBy",
    "deactivatedAt",
    "applicatorCertNo",
    "agronomistCertNo",
    "agronomistName",
    "provisionedByOrgId",
    "createdAt",
    "updatedAt",
    "user",
    "activeSessionCount"
  ]
}"
`;

exports[`API contract — per-schema snapshots schema: AgDashboardAchievements 1`] = `
"{
  "type": [
    "object",
    "null"
  ],
  "properties": {
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "framework-100",
              "evidence-all-current",
              "audit-pack-complete",
              "first-practice-mapped",
              "first-field-mapped",
              "spray-job-complete",
              "first-harvest",
              "season-closed"
            ]
          },
          "earned": {
            "type": "boolean"
          },
          "earnedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "key",
          "earned",
          "earnedAt"
        ]
      }
    },
    "streak": {
      "type": "object",
      "properties": {
        "current": {
          "type": "integer"
        },
        "best": {
          "type": "integer"
        }
      },
      "required": [
        "current",
        "best"
      ]
    }
  },
  "required": [
    "milestones",
    "streak"
  ],
  "description": "Every milestone is returned with \`earned\` false rather than omitted, so a client renders the full set and does not have to know the list. \`earnedAt\` is null exactly when \`earned\` is false."
}"
`;

