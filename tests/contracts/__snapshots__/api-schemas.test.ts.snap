      "type": "string"
    },
    "completedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "productName": {
      "type": "string"
    },
    "productCategory": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "SEED",
        "PESTICIDE",
        "FERTILIZER",
        "AMENDMENT",
        "FUEL",
        "HARVESTED_PRODUCE",
        "OTHER",
        null
      ]
    },
    "doseValue": {
      "type": "string"
    },
