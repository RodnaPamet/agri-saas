exports[`API contract — per-schema snapshots schema: ErrorResponse 1`] = `
"{
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "example": "NOT_FOUND"
        },
        "message": {
          "type": "string",
          "example": "Practice not found"
        },
        "requestId": {
          "type": "string",
          "example": "req_01HG7…"
        },
        "details": {}
      },
      "required": [
        "code",
        "message"
      ]
    }
  },
  "required": [
    "error"
  ],
  "description": "Canonical error envelope returned by every error path. \`code\` is a stable string clients can branch on; \`message\` is human-readable; \`requestId\` correlates with server logs; \`details\` is optional structured context (validation issues, rate-limit info, etc.)."
}"
`;

