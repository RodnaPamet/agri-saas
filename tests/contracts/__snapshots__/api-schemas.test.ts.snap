exports[`API contract — per-schema snapshots schema: ControlCreateRequest 1`] = `
"{
  "type": "object",
  "properties": {
    "code": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "intent": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "IMPLEMENTED",
        "NEEDS_REVIEW"
      ],
      "default": "NOT_STARTED"
    },
    "frequency": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "AD_HOC",
        "DAILY",
        "WEEKLY",
        "MONTHLY",
        "QUARTERLY",
        "ANNUALLY",
        null
      ]
    },
    "ownerUserId": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidenceSource": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "MANUAL",
        "INTEGRATION",
        null
      ]
    },
    "automationKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "mitigationType": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "PREVENTIVE",
        "DETECTIVE",
        "DETERRENT",
        "CORRECTIVE",
        "COMPENSATING",
        null
      ]
    },
    "isCustom": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "description": "Payload for creating a control. Status defaults to NOT_STARTED. \`code\` carries the framework reference where one applies (e.g. ISO 27001:2022 A.5.1) and is minted as \`CTL-N\` for custom controls. Custom controls (isCustom=true) are tenant-specific."
}"
`;

