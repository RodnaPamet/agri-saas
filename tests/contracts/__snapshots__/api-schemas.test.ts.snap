    "success"
  ],
  "description": "Empty success envelope. Returned by mutation endpoints that have no resource to echo back (e.g. status changes, links, deletes)."
}"
`;

exports[`API contract — per-schema snapshots schema: Task 1`] = `
"{
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "tenantId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string"
    },
    "severity": {
      "type": [
        "string",
        "null"
      ]
    },
    "priority": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "dueAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "resolvedAt": {
      "type": [
        "string",
        "null"
      ],
      "deprecated": true,
      "description": "**NEVER SENT — there is no such column.** Use \`completedAt\`. Documented in error; kept only because removing it is a breaking change requiring an API_VERSION bump, which a field that has never been produced does not warrant."
    },
    "completedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "When the task was completed. THIS is the field the server sends — \`resolvedAt\` above is documented in error and never arrives. Detail only: the list projection omits it."
    },
    "key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Human-readable handle, e.g. \`FT-102\`. Present on BOTH the list and the detail — one of the few non-list-projection fields that is."
    },
    "operationType": {
      "type": [
        "string",
        "null"
      ],
      "description": "FIELD_OPERATION only: \`SPRAY\`, \`FERTILIZE\`, \`SEED\` or \`OTHER\`. Persisted so the БАБХ ДНЕВНИК generator can split химични обработки from торове without re-deriving from the title; legacy rows are null and fall back to a derive-from-title reader. Detail only."
    },
    "applicationTechnique": {
      "type": [
        "string",
        "null"
      ],
      "description": "FIELD_OPERATION only — «Техника за приложение», one rig per job. Detail only."
    },
    "clientMutationId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Offline exactly-once handle. When a FIELD_OPERATION is created from a queued outbox the client's outbox-item id rides in as \`Idempotency-Key\`; a replayed write dedupes on (tenantId, clientMutationId) and returns the original task. Null for online creates. Detail only."
    },
    "resolution": {
      "type": [
        "string",
        "null"
      ]
    },
    "practiceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "assigneeUserId": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewerUserId": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdByUserId": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadataJson": {},
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "assignee": {
      "allOf": [
        {
          "$ref": "#/components/schemas/UserRef"
        },
        {
          "type": [
            "object",
            "null"
          ]
        }
      ]
    },
    "reviewer": {
      "allOf": [
        {
          "$ref": "#/components/schemas/UserRef"
        },
        {
          "type": [
            "object",
            "null"
          ]
        }
      ]
    },
    "createdBy": {
      "allOf": [
        {
          "$ref": "#/components/schemas/UserRef"
        },
        {
          "type": [
            "object",
            "null"
          ]
        }
      ]
    }
  },
  "required": [
    "id",
    "tenantId",
    "title",
    "type",
    "status"
  ],
  "additionalProperties": {},
  "description": "Unified work-item record covering audit findings, practice gaps, incidents, improvements, and ad-hoc tasks. The type field discriminates which UI surfaces this row appears in.\\n\\nThe full row. \`GET /tasks\` serves the narrower \`TaskListItem\`; \`GET /tasks/{taskId}\` serves \`TaskDetail\`, which is this plus its relations."
}"
`;

