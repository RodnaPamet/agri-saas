exports[`API contract — per-schema snapshots schema: ParcelClusterOverview 1`] = `
"{
  "type": "object",
  "properties": {
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Hash of the SORTED member ids, not of the grid cell — so a cluster id in a shared URL resolves to the same parcels, and only changes when the membership genuinely differs."
          },
          "lon": {
            "type": "number"
          },
          "lat": {
            "type": "number"
          },
          "count": {
            "type": "integer"
          },
          "parcelIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "totalAreaHa": {
            "type": "number"
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "description": "Nearest settlement name."
          }
        },
        "required": [
          "id",
          "lon",
          "lat",
          "count",
          "parcelIds",
          "totalAreaHa",
          "label"
        ]
      }
    },
    "parcels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "lon": {
            "type": "number"
          },
          "lat": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "lon",
          "lat"
        ]
      },
      "description": "Every POSITIONED parcel, so the view can switch from clusters to parcels once zoomed in — the cluster grid bottoms out at 200 m and cannot separate them."
    },
    "bbox": {
      "description": "[minLon, minLat, maxLon, maxLat] of the positioned parcels."
    },
    "positionedCount": {
      "type": "integer"
    },
    "unpositionedCount": {
      "type": "integer",
      "description": "Parcels with NULL geometry. Never folded into the total: a holding whose map silently omits 30 fields is data loss the farmer cannot see."
    },
    "unpositionedParcelIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "truncated": {
      "type": "boolean",
      "description": "The read hit its 2000-parcel bound; this is a subset."
    }
  },
  "required": [
    "clusters",
    "parcels",
    "positionedCount",
    "unpositionedCount",
    "unpositionedParcelIds",
    "truncated"
  ],
  "description": "Proximity clusters for a location’s parcels, labelled with the nearest settlement."
}"
`;

exports[`API contract — per-schema snapshots schema: ParcelCreateRequest 1`] = `
"{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "cropType": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Polygon"
              ]
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    }
                  ]
                },
                "minItems": 4
              },
              "minItems": 1
            }
          },
          "required": [
            "type",
            "coordinates"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "MultiPolygon"
              ]
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      }
                    ]
                  },
                  "minItems": 4
                },
                "minItems": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "type",
            "coordinates"
          ]
        }
      ]
    }
  },
  "required": [
    "name",
    "geometry"
  ],
  "description": "Hand-drawn parcel. \`geometry\` is a GeoJSON Polygon or MultiPolygon in WGS84; rings need ≥4 positions and lon/lat must be in range. A self-intersecting shape is a 400 — PostGIS is the final arbiter, this only catches the common cases early."
}"
`;

