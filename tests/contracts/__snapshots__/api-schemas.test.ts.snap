exports[`API contract — per-schema snapshots schema: FarmTaskCreateRequest 1`] = `
"{
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "farmTaskType": {
      "type": "string",
      "minLength": 1,
      "description": "A key from the LiteFarm-derived farm-task-type catalog (\`src/lib/agriculture/farm-task-types\`). An unknown key is a 400 \`INVALID_FARM_TASK_TYPE\`."
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 5000
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "dueAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "assigneeUserId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Assigning fires the existing TASK_ASSIGNED notification."
    },
    "locationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    },
    "parcelIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    },
    "equipmentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    }
  },
  "required": [
    "title",
    "farmTaskType"
  ],
  "description": "Create a FARM_TASK. Every id in locationIds/parcelIds/equipmentIds is checked for tenant ownership BEFORE the task is written, so a bad link is a 400 \`INVALID_LINK\` and never leaves an orphan task. Unknown properties are stripped."
}"
`;

