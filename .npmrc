# The Node/npm floor is declared in package.json "engines" (node >=22 <23,
# npm >=10) and .nvmrc (22). CI (.github/workflows) and every Dockerfile stage
# build on node:22-alpine, so 22 is the authoritative toolchain.
#
# Without engine-strict, npm downgrades an engine mismatch to an EBADENGINE
# warning that scrolls past in install output — so a local Node 23/24 install
# silently produces a tree that was never validated against the version CI and
# production actually run. engine-strict turns that into a hard failure at
# install time, where it is cheap to fix.
engine-strict=true
