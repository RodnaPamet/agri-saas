#
# Caddy reverse proxy for agrent.
#
# NOTE (#842): `deploy/apply.sh` copies ONLY docker-compose.vm.yml to the VM,
# and `deploy/check-drift.sh` hashes only that file — so this Caddyfile is
# NOT synchronised and NOT drift-checked. The live copy at
# /opt/agrent/Caddyfile is edited on the VM. This file is the record of what
# it should contain; reconcile changes in BOTH directions by hand.
#
# Reconciled from the VM 2026-09-10: the live site block serves the custom
# domain `app.agrent.bg` alongside the sslip.io host, which this file was
# missing. It also sets ACME_EMAIL in the environment, overriding the default
# below. Let's Encrypt issues a cert automatically on first request for each
# name in the site block.
#

{
    # Use the production LE endpoint by default (default behaviour).
    # Set ACME_EMAIL in the env if you want certificate expiry mail.
    email {$ACME_EMAIL:admin@agrent.bg}
}

35-187-80-26.sslip.io, app.agrent.bg {
    encode gzip zstd

    # Client-body limit roughly matches FILE_MAX_SIZE_BYTES above.
    request_body {
        max_size 110MB
    }

    # Security headers.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }

    reverse_proxy app:3000 {
        # Next.js sits behind the proxy — forward the original host so
        # NextAuth + server-side redirects resolve to the public URL.
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
