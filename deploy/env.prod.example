# deploy/env.prod.example — production env KEYS (no values).
#
# This is the deploy-side companion to src/env.ts. Copy it to the VM as
# /opt/agrent/.env, fill every value, and keep it OFF git. A unit test
# (tests/guardrails/deploy-env-parity.test.ts) asserts that every variable
# src/env.ts REQUIRES in production appears here — so a newly-required var can't
# ship without this file learning about it.
#
# NEVER commit real values. NEVER echo /opt/agrent/.env in logs or CI.

# ── Core: database (PgBouncer at runtime, direct for migrations) ──
DATABASE_URL=
DIRECT_DATABASE_URL=

# ── Redis (REQUIRED + AUTHENTICATED in prod — redis://:PASSWORD@HOST:6379) ──
REDIS_URL=

# ── NextAuth / session ──
NEXTAUTH_URL=
AUTH_URL=
AUTH_SECRET=
JWT_SECRET=

# ── Self-service signup flags (feat/free-user-registration) ── BOTH optional.
# Set to 1 to hide the email/password form (and the register toggle) on
# /login, leaving the server OAuth-only at the UI layer. Unset/0 exposes
# self-service signup. Read at request time by /api/auth/ui-config, so
# changing it needs only a container recreate — no rebuild.
AUTH_CREDENTIALS_UI_HIDDEN=0

# Native (iOS/Android shell) sign-in: comma-separated ALLOWED PREFIXES for the
# `redirect_uri` the app asks its auth code to be delivered to. Typically the
# app's custom URL scheme, e.g. `bg.agrent.app://auth`.
#
# EMPTY IS NOT "no restriction" — it is "refuse everything". `isAllowedRedirect`
# fails closed by design (src/lib/auth/native/auth-codes.ts), and the zod schema
# defaults this to "" (src/env.ts). The combination is safe and silent: with the
# key unset, /api/auth/native/start and /complete refuse EVERY redirect and the
# whole native sign-in flow is inert, with no boot error and nothing in the
# response distinguishing it from a bad client.
#
# That was the live state of production on 2026-08-21 — the key was absent from
# /opt/agrent/.env entirely. It is listed here, despite having a schema default,
# precisely because a default that disables a feature is the kind an operator
# never learns about. The server now logs
# `native-auth.redirect_allowlist_unconfigured` at ERROR when this bites; the
# HTTP response deliberately still says `redirect_uri_not_allowed`, because an
# unauthenticated caller must not be told our allowlist is empty.
#
# Leave unset ONLY while no native client exists. Set it before shipping one.
NATIVE_AUTH_REDIRECT_ALLOWLIST=

# Set to 1 to require a confirmed email before a credentials login
# succeeds. Only affects the credentials path — OAuth sign-ins never
# reach the gate (src/lib/auth/credentials.ts:320).
AUTH_REQUIRE_EMAIL_VERIFICATION=1

# ── OAuth providers (required by src/env.ts even when unused — set a value) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Field encryption master KEK (REQUIRED in prod; openssl rand -base64 48) ──
DATA_ENCRYPTION_KEY=

# ── File storage (local disk on the single-VM deploy) ──
UPLOAD_DIR=

# ── Compose interpolation vars (consumed by docker-compose.vm.yml, not env.ts) ──
# Postgres + Redis credentials the container stack builds its URLs from.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
REDIS_PASSWORD=
# Map basemap key baked into the client bundle at build time.
NEXT_PUBLIC_MAPTILER_KEY=
# Browser Sentry DSN — absent ⇒ the client error SDK stays a no-op.
# Baked into the client bundle at build time. Optional (self-hosted stays clean).
# Contact address shown on the public /privacy page. The data CONTROLLER is
# the organisation operating this deployment, so the address cannot be baked
# into the software. UNSET renders no contact block rather than a placeholder
# that reads as a real address.
PRIVACY_CONTACT_EMAIL=

NEXT_PUBLIC_SENTRY_DSN=
# Optional release tag so field crashes map to a deploy.
NEXT_PUBLIC_SENTRY_RELEASE=

# ── Satellite / Google Earth Engine (BOTH optional, but paired) ──
# Powers every Sentinel-2 surface: the /farm-risk per-parcel vegetation +
# moisture risk levels, the location-map NDVI/NDMI/NDRE/GNDVI/EVI index
# overlays, and the satellite half of the AI field briefing. GEE does the
# compute AND serves the tiles — we host no tile server.
#
# UNSET (or only one of the two set) ⇒ satellite is OFF and every surface
# degrades honestly: the index routes report `configured:false`, per-parcel
# readings come back null with "No data" levels, and the briefing runs without
# imagery. Nothing crashes — which is exactly why the state is easy to miss, so
# a prod boot without them logs a `[startup]` WARN and `/api/readyz` reports
# `capabilities.satellite.missing`. Check there first when the farmer says the
# satellite pages are empty.
#
# GEE_PROJECT_ID is the Earth-Engine-registered Cloud project;
# GEE_SERVICE_ACCOUNT_KEY is the FULL service-account JSON key as ONE line.
# GEE_PROJECT_ID=              # e.g. my-ee-project
# GEE_SERVICE_ACCOUNT_KEY=     # {"type":"service_account","project_id":...} (entire JSON, single line)

# ── Bulgarian cadastre (КККР / АГКК) WMS overlay (ALL optional) ──
# The location-map cadastre overlay is HIDDEN unless one of these is set — the
# free INSPIRE view WMS for КККР parcels could not be located by probing, so
# there is no baked-in default. Server-only (never NEXT_PUBLIC): a paid №8002
# licence is IP-bound to the VM, so tiles are fetched server-side via the
# same-origin proxy. Enabling the paid layer is an operator cost decision —
# see docs/implementation-notes/2026-07-13-cadastre-wms-overlay.md for the
# commercial terms (80 лв/мес or 800 лв/год per layer per IP-bound access
# point, Наредба РД-02-20-4/2016 + Тарифа 14, via КАИС).
# CADASTRE_WMS_URL=          # WMS GetMap base OR an ArcGIS …/MapServer (auto-detected).
#                            # Free АГКК parcels source (ArcGIS export, reprojected):
#                            # https://arcgis.cadastre.bg/arcgisnopki/rest/services/ExternalKais/ParcelsCache/MapServer
# CADASTRE_WMS_LAYERS=       # WMS LAYERS (default CP.CadastralParcel)
# CADASTRE_WMS_PREMIUM_URL=  # paid №8002 GetMap base (wins when set)
#
# VECTOR parcels overlay — the FREE default that actually renders (preferred over
# the raster WMS above when set). ArcGIS FeatureServer-style layer; its /query is
# fetched server-side + reprojected to 4326 GeoJSON via the same-origin
# /cadastre/parcels proxy. The client sees only a `configured` boolean.
# CADASTRE_PARCELS_URL=      # https://spp.api.bg/arcgis/rest/services/Public/CadBaseMap/MapServer/2
# КАИС cadastre OpenData import (feat/cadastre-opendata-import). Optional,
# server-only — when unset the "import from the cadastre" tab is hidden.
# CADASTRE_OPENDATA_INDEX_URL=   # https://kais.cadastre.bg OpenData base

# ── Platform-support console (#12) ── OPTIONAL.
# Slug of the tenant whose ADMINS curate the global catalogues (supplier
# companies + promotions) from /t/<slug>/admin/promotions. Real logins, so
# audit rows carry a real userId — unlike the session-less
# PLATFORM_ADMIN_API_KEY used by the machine-facing /api/admin routes.
# UNSET ⇒ the console is unreachable for every tenant (fail closed). Do NOT
# leave this blank expecting a default: it is deliberately inert when empty.
# PLATFORM_TENANT_SLUG=          # e.g. agrent-platform

# ── Market-price trends backbone (feat/trends-data-backbone) ── ALL optional.
# The market-prices-pull job caches SIX sources: EC AGRI-food (grain), the EC
# Weekly Oil Bulletin (diesel), the World Bank Pink Sheet (urea + DAP), Alpha
# Vantage (global reference), Barchart (futures) and our own listings median.
# FOUR of the six need NO configuration whatsoever — EC, the Oil Bulletin, the
# Pink Sheet and listings are public and keyless, and their URLs are defaulted
# in the clients. Only Alpha Vantage and Barchart read a key, and each SKIPS
# cleanly when its key is unset. An empty chart is therefore far more likely to
# mean "the weekly job has not run since this feed shipped" than "something is
# unconfigured" — check the worker logs before setting anything here.
# EC_AGRIFOOD_BASE_URL=          # override EC AGRI-food API base (default https://api.tech.ec.europa.eu/agrifood/api)
# ALPHA_VANTAGE_API_KEY=         # Alpha Vantage free key (enables WHEAT/CORN global reference series)
# BARCHART_API_KEY=              # Barchart OnDemand key — delayed (10-15 min) Euronext MATIF wheat/corn futures.
#                                # NEEDS a per-exchange redistribution licence before showing to end users (see docs).
#
# The market-news-pull job aggregates free agri RSS/Atom feeds into the Trends →
# News tab. Curated defaults live in src/lib/news/feeds.ts; override the whole
# list here without a redeploy (JSON array of {slug,url,category}, category ∈
# market|policy|general). Unset/malformed ⇒ defaults. Fail-soft per feed.
# MARKET_NEWS_FEEDS=             # e.g. [{"slug":"agri-bg","url":"https://agri.bg/rss","category":"general"}]

# ── APP_URL — REQUIRED in practice, despite being optional in src/env.ts ──
# The app's absolute public origin, e.g. https://app.agrent.bg (no trailing
# slash). Used for URLs that leave the request context and therefore have no
# origin to inherit: verification + password-reset email links, and the
# verify-email route's redirect target.
#
# Leaving it unset is NOT harmless. It previously produced, silently:
#   • verification / password-reset emails whose href was "/api/auth/..." —
#     a mail client has no base document, so the link renders as dead text;
#   • a 500 on every verification click, because NextResponse.redirect()
#     requires an absolute URL and throws on a relative one.
# With AUTH_REQUIRE_EMAIL_VERIFICATION=1 that combination let users register
# but never verify, and so never sign in.
#
# getAppBaseUrl() now falls back to NEXTAUTH_URL, so an unset APP_URL degrades
# safely rather than breaking. Set it explicitly anyway when the public origin
# differs from NEXTAUTH_URL.
APP_URL=https://app.agrent.bg

# ── AI provider — completions (ALL optional; unset ⇒ AI_BASE_URL defaults to
# http://localhost:11434/v1, i.e. Ollama, which this VM does not run) ──
# Set AI_BACKEND=claude to route completions through the native Anthropic
# Messages API using ANTHROPIC_API_KEY (below) instead of AI_BASE_URL/
# AI_API_KEY. This does NOT affect embeddings — see the AI_EMBED_* block
# below (fix/rag-embedding-provider-split): Anthropic exposes no embeddings
# endpoint, so the embedding role resolves independently of AI_BACKEND.
# AI_BACKEND=claude
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# ── AI provider — embeddings, RAG ingestion + retrieval (ALL optional) ──
# Option B (see docs/implementation-notes/2026-08-07-rag-embedding-provider-split.md):
# point these at a hosted, OpenAI-compatible embedding API, independent of
# whichever backend serves completions above. An in-VM embedding service was
# rejected — a 768-dim model alongside the other 7 compose services is a
# memory risk, re-embedding load is bursty, and this VM runs no AI
# infrastructure today.
#
# Unset ⇒ each falls back to the completion vars above (AI_BASE_URL /
# AI_API_KEY) — fine for a self-hosted Ollama deploy, but on THIS VM (no
# Ollama, no AI_BASE_URL set) it means embeddings have nothing to talk to.
# retrieve() (src/app-layer/ai/rag/retrieve.ts) degrades gracefully in that
# case — it logs a warning and falls back to keyword-only search rather than
# throwing — so leaving this block unset is safe, just less accurate: RAG
# answers lose the vector-similarity branch and become lexical-only.
# AI_EMBED_BACKEND=openai-compatible
# AI_EMBED_BASE_URL=       # e.g. https://api.openai.com/v1
# AI_EMBED_API_KEY=        # hosted embedding API key — NEVER commit a real value
# AI_EMBED_MODEL=          # e.g. text-embedding-3-small — MUST match the
#                          # KnowledgeChunk.embedding vector(768) column width
