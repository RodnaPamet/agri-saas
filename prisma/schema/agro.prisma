// ═══════════════════════════════════════════════════════════════════
//  AGRO-INTEL DOMAIN — weather obs, agronomic signals, data streams
// ═══════════════════════════════════════════════════════════════════
//
//  GAP-09 multi-file schema: new domain file. Conventions mirror
//  agriculture.prisma / planning.prisma:
//    • cuid ids, createdAt/updatedAt, soft-delete trio where it applies.
//    • `@@unique([id, tenantId])` cross-tenant barrier; composite child
//      FKs `[xId, tenantId] → [id, tenantId]`.
//    • Every tenant-scoped table gets the canonical RLS trio in the
//      migration (rls-coverage derives the set from the DMMF). All four
//      models have a NON-NULL tenantId → standard split-policy form.
//
//  The agronomic MATH is not here — GDD accumulation + the
//  spray-window / disease-risk rules are PURE functions in
//  `src/lib/agro/{gdd,rules}.ts`. These models persist the weather the
//  rules consume + the signals they emit. A disease-risk signal REUSES
//  the GRC Risk register (Risk + matrix + treatment) — `AgroSignal.riskId`
//  points at the created Risk; the AgroSignal row itself is the
//  idempotency key so the daily job never double-fires.
//
//  Back-relations added elsewhere:
//    • auth.prisma   Tenant:   weatherObservations / dataStreams /
//                              dataStreamReadings / agroSignals
//    • agriculture.prisma Location: weatherObservations / dataStreams /
//                                   agroSignals
//    • planning.prisma Planting:  agroSignals
//    • compliance.prisma Risk:    agroSignals
// ═══════════════════════════════════════════════════════════════════

/// One day's weather for a Location, pulled from Open-Meteo (free, no
/// key) by the daily `weather-pull` BullMQ job. Drives GDD accumulation
/// per planting + the spray-window / disease-risk evaluators. One row per
/// (location, date) — the job upserts.
model WeatherObservation {
  id               String   @id @default(cuid())
  tenantId         String
  locationId       String
  /// Calendar day (UTC) the observation is for.
  obsDate          DateTime @db.Date
  /// Provenance — "open-meteo" today.
  source           String   @default("open-meteo")
  tempMaxC         Decimal? @db.Decimal(6, 2)
  tempMinC         Decimal? @db.Decimal(6, 2)
  tempMeanC        Decimal? @db.Decimal(6, 2)
  precipMm         Decimal? @db.Decimal(8, 2)
  windMaxKmh       Decimal? @db.Decimal(7, 2)
  humidityMean     Decimal? @db.Decimal(5, 2)
  /// Location-local hourly rows for this day: [{ hour, windKmh, precipMm, tempC }].
  /// Powers the real "best spray window today" (see computeSprayWindows).
  hourlyJson       Json?
  /// Location UTC offset (seconds, Open-Meteo utc_offset_seconds) — recovers the
  /// location-local "now" so the hourly window drops hours already passed.
  utcOffsetSeconds Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  location Location @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, locationId, obsDate])
  @@index([tenantId, obsDate])
}

/// A sensor / external data stream (farmOS data-stream concept) — behind
/// the AGRO_DATASTREAMS feature flag. A device POSTs readings to the
/// token-gated ingestion endpoint; `ingestTokenHash` is the SHA-256 of
/// the raw token (never stored plainly), mirroring AuditPackShare.
model DataStream {
  id              String           @id @default(cuid())
  tenantId        String
  locationId      String?
  key             String
  name            String
  kind            DataStreamKind
  unit            String?
  /// SHA-256(rawIngestToken). Null until a token is minted.
  ingestTokenHash String?
  status          DataStreamStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  deletedByUserId String?
  retentionUntil  DateTime?

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  location Location?           @relation(fields: [locationId, tenantId], references: [id, tenantId])
  readings DataStreamReading[]

  @@unique([id, tenantId])
  @@unique([tenantId, key])
  @@index([tenantId, locationId])
  @@index([tenantId, status])
  @@index([ingestTokenHash])
}

/// A single reading on a DataStream (time-series). Written by the
/// ingestion endpoint. High-volume — kept lean.
model DataStreamReading {
  id           String   @id @default(cuid())
  tenantId     String
  dataStreamId String
  recordedAt   DateTime
  value        Decimal  @db.Decimal(18, 6)
  unit         String?
  rawJson      Json?
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  dataStream DataStream @relation(fields: [dataStreamId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, dataStreamId, recordedAt])
}

/// An agronomic signal the daily job emits from the weather rules — a
/// spray-window warning or a disease-risk escalation. The row is the
/// IDEMPOTENCY key (one per location/kind/day) and records whether a
/// notification was sent. It used to also carry a `riskId` into the GRC
/// Risk register; that register was removed with the compliance uproot,
/// and an agronomic signal was never really a governance risk row.
model AgroSignal {
  id          String         @id @default(cuid())
  tenantId    String
  locationId  String
  plantingId  String?
  kind        AgroSignalKind
  /// Free severity label per kind (e.g. UNSUITABLE / HIGH).
  level       String?
  signalDate  DateTime       @db.Date
  notified    Boolean        @default(false)
  detailsJson Json?
  createdAt   DateTime       @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  location Location  @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  planting Planting? @relation(fields: [plantingId, tenantId], references: [id, tenantId])

  @@unique([tenantId, locationId, kind, signalDate])
  @@index([tenantId, signalDate])
  @@index([tenantId, plantingId])
}

/// A platform-admin correction or addition to the published agronomic
/// calendar — #3095. TENANTLESS: agronomy for North Bulgaria is the same
/// agronomy for every farm there, so a per-farm override would be a different
/// feature (a farm's own adjusted plan) and must not be confused with
/// correcting a published figure.
///
/// ## The whole window is stored, not a field-level patch
///
/// A patch cannot say whether an absent field means "unchanged" or "removed",
/// and a correction is in practice "here is how this window should now read".
/// Nothing is lost by storing it whole: the published original stays in
/// `dataset.json` and is served as `supersedes`, so the admin console can show
/// what МЗХ said beside what the operator typed.
///
/// ## `basisBg` is NOT NULL, which is the ruling made structural
///
/// An override changes the VALUE while the published citation still points at
/// a page that no longer supports it — worse than an uncited window, because
/// it looks sourced. So a correction without a stated basis cannot exist, and
/// the served window carries `basis` INSTEAD of `cites` rather than beside it.
///
/// ## Clearing means two different things
///
/// `clearedAt` on a CORRECTED row restores МЗХ's window; on an ADDED row it
/// removes the window entirely. The clear API reports which happened, because
/// an operator who clears an added window and reads "restored" would go
/// looking for a window that no longer exists.
///
/// Cleared rows are KEPT, so the uniqueness below is partial — one LIVE
/// override per window, any number of historical ones.
model AgroCalendarOverride {
  id         String                     @id @default(cuid())
  /// The window addressed. A published window's id for CORRECTED; a new id
  /// this row brings into existence for ADDED.
  windowId   String
  /// The crop whose window this is, so an ADDED window has somewhere to live.
  cropKey    String
  origin     AgroCalendarOverrideOrigin
  /// The window as it should now read, validated against the calendar's own
  /// window schema minus its citation. An override never carries a citation:
  /// that is what `basisBg` replaces.
  windowJson Json
  /// Why the figure differs from the card. Required and non-blank.
  basisBg    String
  basisEn    String?
  /// Null while live. See the clearing note above.
  clearedAt  DateTime?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  /// Who, as honestly as the credential allows — a platform user id from the
  /// session door, or `platform-key:<generation>` from the keyed one. #1619's
  /// rule: there is one `PLATFORM_ADMIN_API_KEY`, so a keyed write names a key
  /// generation and not a person, and the trail says so rather than implying
  /// more.
  authorRef  String

  @@index([windowId])
  @@index([cropKey])
  /// Partial-unique on `windowId WHERE clearedAt IS NULL` is added by raw SQL
  /// in the migration — Prisma cannot express a partial index, and without it
  /// two live overrides on one window would make the served value depend on
  /// row order.
  @@index([clearedAt])
}
