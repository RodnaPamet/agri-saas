// ═══════════════════════════════════════════════════════════════════
//  ENTERPRISE-GRAIN DOMAIN — marketing contracts + harvest yield records
// ═══════════════════════════════════════════════════════════════════
//
//  GAP-09 multi-file schema: the large grain-producer persona. Generator
//  + datasource remain in base.prisma. Conventions mirror
//  planning.prisma / agriculture.prisma:
//    • cuid ids, createdAt/updatedAt, soft-delete trio
//      (deletedAt / deletedByUserId / retentionUntil — bare scalars).
//    • Cross-tenant barrier `@@unique([id, tenantId])`; child FKs are
//      composite `[xId, tenantId] → [id, tenantId]`.
//    • Every tenant-scoped table gets the canonical RLS trio
//      (tenant_isolation + tenant_isolation_insert + superuser_bypass +
//      FORCE) in the migration. Both models have NON-NULL tenantId, so
//      both use the standard split-policy form.
//
//  ── Plaintext vs encrypted (Epic B field-encryption manifest) ──
//  Commercially-sensitive FREE TEXT (negotiated terms, pricing rationale,
//  valuation commentary) is encrypted at rest via
//  `src/lib/security/encrypted-fields.ts`:
//      Contract.terms, Contract.pricingNotes, YieldRecord.valuationNotes,
//      PayrollExpense.description
//  The NUMERIC magnitudes (volumeTonnes, pricePerTonne, grossTonnes,
//  moisturePct, areaHa, PayrollExpense.amount) stay PLAINTEXT Decimals so
//  the portfolio / cost / yield rollups can aggregate them in-DB — an
//  encrypted column cannot be SUM()'d. Encrypted columns MUST be nullable
//  String (the middleware encrypts strings into the same column).
//
//  Back-relations added elsewhere (Prisma needs both sides):
//    • auth.prisma        Tenant:   contracts / yieldRecords / grainDeliveries /
//                                   payrollExpenses
//    • auth.prisma        User:     payrollExpensesCreated
//    • agriculture.prisma Location: yieldRecords
//    • planning.prisma    Season:   contracts / yieldRecords / payrollExpenses
//    • planning.prisma    Planting: yieldRecords / payrollExpenses
//
//  ── Production vs delivery (the fulfilment loop) ──
//  YieldRecord is PRODUCTION (what came off the field); GrainDelivery is
//  DISPATCH (what physically moved against a specific contract). They are
//  deliberately separate rows: one harvest can serve several buyers, grain
//  sits in a bin in between, and a contract can be filled from several
//  harvests. Attributing a tonne to a counterparty is what closes the loop
//  — `Contract.status = DELIVERED` is gated on real GrainDelivery movement
//  (see `src/app-layer/usecases/contract.ts`).
// ═══════════════════════════════════════════════════════════════════

/// A grain marketing / supply contract — a forward SALE of produce or
/// PURCHASE of inputs with a counterparty. `volumeTonnes` +
/// `pricePerTonne` are plaintext (portfolio "contracted volume / value"
/// rollups SUM them); the negotiated `terms` + `pricingNotes` narrative
/// is encrypted at rest. Tenant-scoped.
model Contract {
  id              String         @id @default(cuid())
  tenantId        String
  /// Optional link to the marketing-year Season. Drives the org
  /// portfolio's per-season contracted-vs-produced rollup
  /// (`getPortfolioGrainSummary().perSeason`), which pairs these
  /// contracted tonnes against `YieldRecord.grossTonnes` for the same
  /// season. That rollup counts ACTIVE + DELIVERED + SETTLED — every
  /// commitment ever really made against the harvest — which is a
  /// WIDER set than the live-book headline. See
  /// `CONTRACTED_SEASON_STATUSES` in
  /// `src/app-layer/domain/contract-status.ts`.
  seasonId        String?
  /// External contract reference / number — the reference printed on
  /// the paper the farmer is holding. Unique per tenant among LIVE
  /// rows: the DB index is PARTIAL (`WHERE deletedAt IS NULL`, see
  /// migration 20260725140000) so deleting a contract releases its
  /// number for re-use. Prisma cannot express a partial index, so the
  /// `@@unique` below states the logical constraint.
  key             String?
  /// Buyer (SALE) or supplier (PURCHASE) name — plaintext, filterable.
  counterparty    String
  /// Commodity traded, e.g. "Wheat", "Malting Barley" — plaintext.
  ///
  /// This stays FREE TEXT on purpose: it is what the farmer typed off the
  /// paper contract in their hand, and "Malting Barley" is not "Barley" —
  /// the distinction is commercially real, and destroying it to gain a join
  /// key would be a bad trade. The canonical slug lives beside it instead.
  commodity       String?
  /// Canonical commodity slug derived from `commodity` via
  /// `normalizeCommodity` (src/lib/market/commodity-vocabulary.ts), or null
  /// when the free text names something the vocabulary does not cover.
  ///
  /// THE JOIN KEY. Trends was a read-only island precisely because no two of
  /// the four commodity vocabularies could be joined — this column is what
  /// makes "am I selling above or below market?" expressible at all. Written
  /// on every create/update, backfilled by 20260805090000_commodity_canonical.
  commodityCanonical String?
  type            ContractType   @default(SALE)
  status          ContractStatus @default(DRAFT)
  /// Contracted volume in metric tonnes — plaintext (SUM'd by rollups).
  volumeTonnes    Decimal?       @db.Decimal(14, 3)
  /// Agreed price per tonne — plaintext. Contract value =
  /// `volumeTonnes × pricePerTonne`, computed Decimal-exactly by
  /// `computeContractValue` (`src/lib/grain/contract-value.ts`) and
  /// surfaced per row + as a per-currency book total on the list. Values
  /// are NEVER summed across `priceCurrency`.
  pricePerTonne   Decimal?       @db.Decimal(14, 2)
  priceCurrency   String?
  deliveryStart   DateTime?
  /// End of the agreed delivery window. Backs the "closing soon" /
  /// "overdue" signal on ACTIVE contracts (`deriveContractWindowState`)
  /// and the daily `contract-delivery-window-sweep` job — the
  /// `[tenantId, deliveryEnd]` index below is what that sweep scans.
  deliveryEnd     DateTime?
  /// ENCRYPTED (Epic B manifest) — full negotiated contract terms.
  terms           String?
  /// ENCRYPTED (Epic B manifest) — pricing basis / premium rationale.
  pricingNotes    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  deletedByUserId String?
  retentionUntil  DateTime?

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  season     Season?         @relation(fields: [seasonId, tenantId], references: [id, tenantId])
  deliveries GrainDelivery[]

  @@unique([id, tenantId])
  @@unique([tenantId, key])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, seasonId])
  @@index([tenantId, deliveryStart])
  /// Backs the delivery-window sweep's `deliveryEnd` range scan, which
  /// is filtered on status — hence the status column in the composite.
  @@index([tenantId, status, deliveryEnd])
  /// Join key to MarketPriceSeries — drives the contract-vs-market read.
  @@index([tenantId, commodityCanonical])
}

/// One physical DELIVERY of tonnage against a Contract — a weighbridge
/// ticket, in effect. This is the row that closes the fulfilment loop:
/// `SUM(tonnes)` per contract gives delivered-to-date, and
/// `Contract.volumeTonnes − delivered` gives what is still owed to that
/// counterparty.
///
/// Deliberately NOT a field on YieldRecord: production is not dispatch
/// (see the header note). `contractId` is REQUIRED — a delivery with no
/// contract is just an inventory movement and belongs to the stock
/// ledger, not here.
///
/// Every column is plaintext: `tonnes` is a magnitude the fulfilment
/// rollups SUM in-DB, and `reference` is a short external identifier
/// (weighbridge / delivery-note number) that operators filter on. The
/// commercially-sensitive narrative for a deal stays on the parent
/// Contract (`terms` / `pricingNotes`, both encrypted) — this row
/// carries no free-text commentary, so the Epic-B split holds by
/// construction rather than by manifest entry.
model GrainDelivery {
  id              String   @id @default(cuid())
  tenantId        String
  /// The contract this movement is delivered against.
  contractId      String
  /// When the tonnage physically moved.
  deliveredAt     DateTime
  /// Delivered mass in metric tonnes — plaintext (SUM'd by the
  /// fulfilment rollup). Non-null: a delivery of "unknown" tonnes
  /// cannot close any part of a contract.
  tonnes          Decimal  @db.Decimal(14, 3)
  /// Weighbridge ticket / delivery-note reference — plaintext.
  reference       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  deletedByUserId String?
  retentionUntil  DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  contract Contract @relation(fields: [contractId, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@index([tenantId, contractId])
  @@index([tenantId, deliveredAt])
}

/// An actual harvest production record — gross tonnes realised against a
/// Planting / field / Season, with the moisture basis + area for a t/ha
/// derivation. The detailed per-lot grain quality (test weight, protein,
/// per-lot moisture) lives on `InventoryLot.attributesJson`; this row is
/// the FIELD-level production total. Numeric magnitudes are plaintext
/// (yield rollups SUM them); only the commercial `valuationNotes` is
/// encrypted. Tenant-scoped.
model YieldRecord {
  id              String    @id @default(cuid())
  tenantId        String
  /// Optional link to the Planting whose harvest this realises.
  plantingId      String?
  /// Optional link to the field (Location) the produce came off.
  locationId      String?
  /// Optional link to the marketing-year Season.
  seasonId        String?
  /// The journal HARVEST entry this record was minted from, when the farmer
  /// recorded the harvest ONCE and asked for it to count as both stock and
  /// yield. NULL for a yield typed directly on /grain/yield.
  ///
  /// This is the reconciliation link: `logEntryId IS NOT NULL` means the
  /// same physical grain is ALSO represented as an InventoryLot +
  /// HARVEST_IN ledger row (reachable via StockTransaction.logEntryId), so
  /// the org dashboard can say which of its recorded production already
  /// entered store instead of presenting two unrelated tonnages.
  /// UNIQUE (with tenantId, below) — one harvest entry mints at most one
  /// yield record, which is what makes the journal→yield effect idempotent.
  logEntryId      String?
  /// Commodity harvested, e.g. "Wheat" — plaintext. Free text, as on
  /// Contract: it is what was recorded at the weighbridge.
  commodity       String?
  /// Canonical commodity slug derived from `commodity` — the join key to
  /// MarketPriceSeries. See Contract.commodityCanonical.
  commodityCanonical String?
  harvestedAt     DateTime?
  /// Gross harvested mass in metric tonnes — plaintext (SUM'd by rollups).
  grossTonnes     Decimal?  @db.Decimal(14, 3)
  /// Moisture % at which grossTonnes was measured — plaintext.
  moisturePct     Decimal?  @db.Decimal(5, 2)
  /// grossTonnes expressed at the 14% standard moisture basis, so two
  /// harvests measured at different moistures can be summed and ranked.
  ///
  /// DATABASE-GENERATED (`GENERATED ALWAYS AS ... STORED`) — the application
  /// never writes it. That is deliberate: a derived tonnage maintained by
  /// application code drifts the moment any write path forgets to recompute
  /// it, whereas Postgres recomputes this on every insert and update of its
  /// inputs. Being a real stored column, it is also SUM()-able in-DB, which
  /// is what lets the portfolio rollups stay pure aggregates instead of
  /// loading rows to normalise them in memory.
  ///
  /// NULL when moisturePct is NULL — an unmeasured record has no comparable
  /// weight, and callers report those tonnes separately rather than
  /// assuming they were at standard. See src/lib/grain/moisture.ts for the
  /// formula and tests/guards/generated-columns.test.ts for the guard that
  /// keeps application code from writing it.
  netTonnesStd    Decimal?  @db.Decimal(14, 3)
  /// Harvested area in hectares — plaintext (drives t/ha).
  areaHa          Decimal?  @db.Decimal(12, 4)
  /// ENCRYPTED (Epic B manifest) — commercial valuation commentary.
  valuationNotes  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  deletedByUserId String?
  retentionUntil  DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  planting Planting? @relation(fields: [plantingId, tenantId], references: [id, tenantId])
  location Location? @relation(fields: [locationId, tenantId], references: [id, tenantId])
  season   Season?   @relation(fields: [seasonId, tenantId], references: [id, tenantId])
  logEntry LogEntry? @relation(fields: [logEntryId, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  // One yield record per harvest entry — the idempotency guarantee behind
  // the journal→yield effect. Nullable column ⇒ NULLS DISTINCT, so the many
  // yields typed directly on /grain/yield never collide with each other.
  // Also indexes the FK (logEntryId leads), satisfying the Layer-B index
  // guardrail.
  @@unique([logEntryId, tenantId])
  @@index([tenantId, plantingId])
  @@index([tenantId, locationId])
  @@index([tenantId, seasonId])
  @@index([tenantId, harvestedAt])
  /// Join key to MarketPriceSeries.
  @@index([tenantId, commodityCanonical])
}

/// A payroll / labour cost incurred by the farm — wages, contractor
/// day-rates, seasonal harvest-crew pay. First-class COST alongside
/// `LogEntry.costAmount` / `StockTransaction.costAmount` (see
/// `src/app-layer/usecases/cost-rollup.ts`), tracked as its own producer:
/// labour is often a farm's single biggest cost line, and neither the
/// journal event cost nor the stock ledger has a slot for "I paid the
/// harvest crew."
///
/// `plantingId` / `seasonId` are OPTIONAL BY DESIGN — plenty of payroll
/// rows (a bookkeeper's salary, a full-time tractor driver's monthly
/// wage) are not attributable to one crop. A later net-worth / whole-farm
/// P&L calculator is expected to allocate the unattributed rows pro-rata
/// by harvested area; this model is the PRODUCER of the raw expense, not
/// the allocator — no allocation logic lives here.
///
/// `description` is ENCRYPTED at rest (Epic B manifest) — it can name an
/// employee or contractor ("Overtime, combine operator I. Petrov"), which
/// is personal as well as commercial detail. `amount` stays a PLAINTEXT
/// Decimal (an encrypted numeric cannot be SUM()'d by a future payroll /
/// labour-cost rollup) — the same plaintext-magnitude /
/// encrypted-narrative split as Contract / YieldRecord. Tenant-scoped.
model PayrollExpense {
  id              String    @id @default(cuid())
  tenantId        String
  /// Payroll spend for the period — plaintext (a future cost rollup SUMs
  /// it in-DB). Matches `ParcelLease.rentAmount`'s precision
  /// (agriculture.prisma:449).
  amount          Decimal   @db.Decimal(14, 2)
  /// ISO-4217 currency code, e.g. "BGN" / "EUR" — plaintext, mirrors
  /// `Contract.priceCurrency`.
  currency        String
  /// The pay period / disbursement date this expense belongs to. Drives
  /// the list's default newest-first sort.
  incurredOn      DateTime
  /// ENCRYPTED (Epic B manifest) — free text that can name an employee or
  /// contractor. sanitizePlainText'd before encryption.
  description     String?
  /// Optional link to the Planting this labour cost is attributable to.
  /// NULL when the cost is not tied to one crop (see model doc above).
  plantingId      String?
  /// Optional link to the marketing-year Season.
  seasonId        String?
  /// Who recorded this expense. Optional — a future bulk/background
  /// import has no interactive user.
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  deletedByUserId String?
  retentionUntil  DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  planting  Planting? @relation(fields: [plantingId, tenantId], references: [id, tenantId])
  season    Season?   @relation(fields: [seasonId, tenantId], references: [id, tenantId])
  createdBy User?     @relation("PayrollExpenseCreator", fields: [createdByUserId], references: [id])

  @@unique([id, tenantId])
  /// List filter+sort shape: newest-incurred-first, tenant-scoped
  /// (listPayrollExpenses default `orderBy: [{ incurredOn: 'desc' }, …]`).
  @@index([tenantId, incurredOn])
  @@index([tenantId, plantingId])
  @@index([tenantId, seasonId])
}

/// A single cost a farmer entered, with an optional invoice.
///
/// `/grain/costs` used to be a read-only rollup of
/// `COST_METRICS.ATTRIBUTED_CROP_COST`. The grain net-worth calculator now
/// reports that same figure as part of a larger answer, so the page became
/// the place a cost is ENTERED instead — one form for every kind of spend,
/// rather than a farmer hunting for which of five surfaces owns it.
///
/// ── This row is a RECORD, not a LEDGER entry ────────────────────────
///
/// A CostEntry never mints a `StockTransaction`. That ledger is
/// hash-chained and append-only (`previousHash`/`entryHash` with an
/// `IMMUTABLE_STOCK_LEDGER` trigger blocking UPDATE and DELETE), it
/// requires `lotId`/`unitId`/`quantityDelta` — a product and a quantity,
/// which a money form does not have — and its `costAmount` is a MOVEMENT
/// TOTAL rather than a rate. Minting from a money form would make a
/// mistyped cost permanently uncorrectable and would relink every
/// subsequent hash in the tenant. Domain pages READ the entries that link
/// to them; where a real record already exists (a `LeasePayment`, a stock
/// receipt) an entry LINKS to it. Linking is reversible; minting is not.
///
/// ── The domain links ────────────────────────────────────────────────
///
/// At most ONE of plantingId / seasonId / locationId / parcelId / leaseId
/// is set, and `leaseId` only when `category = RENT`. The columns are what
/// let a domain page show the costs that relate to it without a join
/// table. Prisma cannot express "exactly one of these" — the invariant is
/// enforced in the usecase (`assertSingleDomainLink`) and asserted by an
/// executing test, because a row with two links would appear on two pages
/// and be counted twice by anything summing per-domain.
model CostEntry {
  id              String       @id @default(cuid())
  tenantId        String
  category        CostCategory
  /// Plaintext — cost figures are SUMmed in-DB, and Decimal columns cannot
  /// carry the Epic B ciphertext (a "v2:"-prefixed base64 STRING) anyway.
  /// Listing it in the encryption manifest would fail SILENTLY: the
  /// middleware skips every non-string value without logging.
  amount          Decimal      @db.Decimal(14, 2)
  /// ISO-4217 code, e.g. "BGN" / "EUR". Plaintext, mirrors
  /// `PayrollExpense.currency`. Never blended — there is no FX table in
  /// this repo, so consumers group BY currency or refuse.
  currency        String
  /// The date the cost was incurred. Drives the list's newest-first sort.
  incurredOn      DateTime
  /// Who was paid. Deliberately NOT encrypted: the manifest bans
  /// `contains` / `startsWith` / `orderBy` on encrypted columns and makes
  /// GROUP BY impossible (randomised AES-GCM gives one group per row),
  /// which would foreclose the supplier filter and any typeahead. A
  /// supplier's name on an invoice is not the commercial detail the
  /// manifest protects. sanitizePlainText'd before persisting.
  supplier        String?
  /// ENCRYPTED (Epic B manifest) — free text that can carry commercial
  /// terms. sanitizePlainText'd before encryption.
  description     String?
  /// The invoice, if one was attached. A caller must verify the
  /// FileRecord is `STORED` and not soft-deleted before pointing here —
  /// see `assertUsableInvoice`.
  invoiceFileId   String?
  plantingId      String?
  seasonId        String?
  locationId      String?
  parcelId        String?
  /// Set only when `category = RENT`. The lease this payment settles.
  leaseId         String?
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  deletedByUserId String?
  retentionUntil  DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  planting    Planting?    @relation(fields: [plantingId, tenantId], references: [id, tenantId])
  season      Season?      @relation(fields: [seasonId, tenantId], references: [id, tenantId])
  location    Location?    @relation(fields: [locationId, tenantId], references: [id, tenantId])
  parcel      Parcel?      @relation(fields: [parcelId, tenantId], references: [id, tenantId])
  lease       ParcelLease? @relation(fields: [leaseId, tenantId], references: [id, tenantId])
  /// Referenced by `id` alone, not the usual `[id, tenantId]` tenant
  /// barrier: `FileRecord` carries no `@@unique([id, tenantId])`, and the
  /// existing precedent (`LogEntry.fileRecord`, journal.prisma:171) does
  /// the same. Same-tenant ownership is therefore a USECASE obligation —
  /// `assertUsableInvoice` checks it alongside STORED and not-deleted.
  invoiceFile FileRecord?  @relation(fields: [invoiceFileId], references: [id])
  createdBy   User?        @relation("CostEntryCreator", fields: [createdByUserId], references: [id])

  @@unique([id, tenantId])
  /// List filter+sort shape: newest-incurred-first, tenant-scoped, with the
  /// category facet applied (`listCostEntries` default
  /// `orderBy: [{ incurredOn: 'desc' }, { id: 'desc' }]`).
  @@index([tenantId, incurredOn])
  @@index([tenantId, category, incurredOn])
  /// One composite PER foreign key, deliberately not one wide index: Layer
  /// B's `fkAdequatelyIndexed` tests `group[1] === fk` and never reads
  /// `group[2]`, so `[tenantId, plantingId, seasonId]` would cover
  /// plantingId and leave seasonId a violation.
  @@index([tenantId, plantingId])
  @@index([tenantId, seasonId])
  @@index([tenantId, locationId])
  @@index([tenantId, parcelId])
  @@index([tenantId, leaseId])
  @@index([tenantId, invoiceFileId])
}
