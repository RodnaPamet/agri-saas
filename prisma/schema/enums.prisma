enum NotificationType {
  EVIDENCE_DUE_SOON
  EVIDENCE_OVERDUE
  EVIDENCE_REJECTED
  EVIDENCE_APPROVED
  POLICY_APPROVAL_NEEDED
  POLICY_ACKNOWLEDGED
  FINDING_ASSIGNED
  FINDING_VERIFIED
  TASK_ASSIGNED
  // 2026-05-27 — fired by `setControlOwner` (mutations.ts) when
  // ownership transfers. Mirrors the TASK_ASSIGNED contract:
  // one in-app notification per (control, new owner, day) pair,
  // routed to the bell. Email + SSE follow the same dedup.
  CONTROL_ASSIGNED
  // 2026-05-30 — fired by `updateRisk` / `updateAsset` when the
  // `ownerUserId` ("Assigned to") changes. Same one-per-(entity,
  // owner, day) bell contract as CONTROL_ASSIGNED.
  RISK_ASSIGNED
  ASSET_ASSIGNED
  // Fired by the `task-due-notification` job at 08:00 UTC. One
  // notification per task at each of three reminder windows — one
  // week before, one day before, and on the calendar day the
  // task's `dueAt` falls. In-app only — the email deadline digest
  // already covers the same surface.
  TASK_DUE
  // Audit Coherence S6 (2026-05-22) — daily cron sweeps vendors
  // whose `nextReviewAt` has passed and fires one of these per
  // overdue vendor (routed to the vendor's `ownerUserId`). Bumps
  // the date forward by the cadence so the reminder isn't spam.
  VENDOR_REVIEW_DUE
  // Phase 1 inventory (2026-06-14) — fired by the `low-stock-monitor`
  // daily job when an item's total on-hand (Σ lot quantityOnHand) drops
  // below `Item.reorderLevel`. One bell notification per (item, owner,
  // day); routed to the tenant's OWNER/ADMIN members.
  LOW_STOCK
  // Land administration (2026-07-15) — fired by the `lease-expiry-sweep`
  // daily job when a parcel lease (аренда/наем) is within 30 days of its
  // endDate. One bell notification per (lease, owner, endDate); routed to
  // the tenant's OWNER/ADMIN members.
  LEASE_EXPIRING
  // Grain fulfilment (2026-07-25) — fired by the
  // `contract-delivery-window-sweep` daily job for an ACTIVE contract
  // whose `deliveryEnd` is near or past. Scoped to ACTIVE only: a DRAFT
  // is unsigned, CANCELLED is void, and DELIVERED/SETTLED are already
  // fulfilled, so none of them can be "late". One bell notification per
  // (contract, recipient, deliveryEnd, phase) — the phase bucket means a
  // contract alerts once on approach and once when it goes overdue,
  // never daily. Routed to the tenant's OWNER/ADMIN members.
  CONTRACT_DELIVERY_DUE
  GENERAL
}

