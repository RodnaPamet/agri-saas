}

enum LossEventSource {
  /// Recorded by a person (manual entry on the loss-event register).
  USER
  /// Recorded from a finding's close-out — the actual loss that
  /// finding ended up costing.
  FINDING
  /// Recorded from an incident / ticket — the realised cost the
  /// incident closed at.
  INCIDENT
}

// ═══════════════════════════════════════════════════════════════════
//  AGRICULTURE DOMAIN (Feature 1 — spray-prescription map module)
// ═══════════════════════════════════════════════════════════════════

/// Lifecycle of a Location (the farm/field block a farmer uploads a
/// spatial file into). Mirrors AssetStatus semantics.
enum LocationStatus {
  ACTIVE
  ARCHIVED
}

/// What a Location physically IS. Enterprise-grain adds storage
/// semantics: a BIN/STORAGE Location carries `capacityTonnes` and holds
/// InventoryLots of HARVESTED_PRODUCE. FIELD is the default (a growing
/// area with parcels) — every pre-grain Location migrates to FIELD.
enum LocationKind {
  FIELD
  BIN
  STORAGE
}

/// Direction of a grain marketing/supply Contract from the tenant's
/// point of view. SALE = forward-sell produce; PURCHASE = forward-buy
/// inputs. Drives the portfolio "contracted volume" rollup sign.
enum ContractType {
  SALE
  PURCHASE
}

/// Lifecycle of a Contract. DRAFT → ACTIVE (signed) → DELIVERED
/// (volume moved) → SETTLED (paid); CANCELLED is terminal from any
/// pre-SETTLED state.
enum ContractStatus {
  DRAFT
  ACTIVE
  DELIVERED
  SETTLED
  CANCELLED
}

/// Category of an inventory Item. For Feature 1 only the input
/// products (PESTICIDE/FERTILIZER) are exercised; the rest are
/// seeded ahead of the full inventory module.
enum ItemCategory {
  SEED
  PESTICIDE
  FERTILIZER
  AMENDMENT
  FUEL
  HARVESTED_PRODUCE
  OTHER
}

/// Dimension of a unit of measure; constrains which Unit a dose may
/// use (a spray dose is a RATE such as L/ha).
enum QuantityMeasure {
  COUNT
  WEIGHT
  VOLUME
  AREA
  LENGTH
  RATE
  OTHER
}

/// Type of field operation carried by a FIELD_OPERATION Task.
enum FieldOperationType {
  SPRAY
  FERTILIZE
  SEED
  OTHER
}

/// Per-parcel execution state of a field operation. The job (Task)
/// auto-resolves when every line is DONE or SKIPPED.
enum ParcelOperationStatus {
  PENDING
  DONE
  SKIPPED
}

/// WP-2 — per-tenant module gating. A module is available when the
/// tenant has enabled it (TenantModuleSettings.enabledModules). When a
/// tenant has NO settings row, all modules are enabled (backward-compat);
/// a tenant opts into "simple mode" by restricting the list. Resolved in
/// src/lib/modules.ts, enforced by assertModuleEnabled() at the usecase /
/// API boundary. Coverage: tests/guardrails/module-gate-coverage.test.ts.
enum ModuleKey {
  JOURNAL
  INVENTORY
  PLANNING
  CERTIFICATION
  VENDORS
  AUTOMATION
  PROCESSES
  AI
  GRAIN
  EXCHANGE
}

// ─── Exchange domain (exchange.prisma) ───────────────────────────────
// Cross-tenant agriculture marketplace. GLOBAL tables (no tenantId, no
// RLS) — see exchange.prisma header for the isolation model.

/// Which side of the market a listing represents.
enum ExchangeSide {
  SELL
  BUY
}

/// What class of good a listing trades (#11) — lets buyers/sellers browse +
/// filter by product type across the marketplace.
enum ExchangeKind {
  CULTURE
  FERTILIZER
  SEEDS
  PRODUCT
}

/// Lifecycle of a marketplace listing. ACTIVE listings are the only ones
/// browsable + inquirable; the rest are terminal states.
enum ExchangeListingStatus {
  ACTIVE
  FULFILLED
  WITHDRAWN
  EXPIRED
}

/// Lifecycle of an inquiry a buyer/seller sends against a listing.
enum ExchangeInquiryStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// Phase-1 inventory ledger event types (ERPNext stock-ledger concept,
/// reimplemented). Signed `quantityDelta`: RECEIPT/HARVEST_IN positive,
/// CONSUMPTION/SALE_OUT/DISPOSAL negative, ADJUSTMENT either sign
/// (reason required), TRANSFER paired. CONSUMPTION on spray completion
/// carries a `logEntryId` so the journal and ledger reconcile.
enum StockTransactionType {
  RECEIPT
  CONSUMPTION
  HARVEST_IN
  TRANSFER
  ADJUSTMENT
  SALE_OUT
  DISPOSAL
}

/// Journal entry types (farmOS log-type ontology, reimplemented).
/// INPUT_APPLICATION is the traceability-critical spray/fertiliser
/// record auto-emitted on OperationParcel completion.
enum LogEntryType {
  ACTIVITY
  OBSERVATION
  INPUT_APPLICATION
  SEEDING
  TRANSPLANTING
  HARVEST
  IRRIGATION
  MAINTENANCE
  LAB_TEST
  GRAZING
}

/// A PLANNED journal entry doubles as scheduled field work; DONE is the
/// recorded field event. Spray-completion records are written DONE.
enum LogEntryStatus {
  PLANNED
  DONE
}

// ─── Crop planning domain (planning.prisma) ──────────────────────────

enum SeasonStatus {
  PLANNING
  ACTIVE
  CLOSED
}

enum CropPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Whether a planting is sown in place or started and transplanted out —
/// drives the succession-engine date math (transplant offset vs none).
enum PlantingMethod {
  DIRECT_SOW
  TRANSPLANT
}

enum PlantingStatus {
  PLANNED
  SOWN
  TRANSPLANTED
  HARVESTING
  HARVESTED
  TERMINATED
}

/// Which planned milestone a journal LogEntry realises (LogPlanting) and
/// which auto-generated field task a planting needs.
enum PlantingStage {
  SOW
  TRANSPLANT
  HARVEST
}

// ─── Agro-intel domain (agro.prisma) ─────────────────────────────────

enum DataStreamKind {
  TEMPERATURE
  SOIL_MOISTURE
  HUMIDITY
  RAINFALL
  WIND
  LEAF_WETNESS
  CUSTOM
}

enum DataStreamStatus {
  ACTIVE
  DISABLED
}

/// What an AgroSignal represents — a spray-window suitability warning or a
/// disease-pressure escalation. Disease risk reuses the GRC Risk register.
enum AgroSignalKind {
  SPRAY_WINDOW
  DISEASE_RISK
}

/// Lot genealogy edge kind (OFBiz lot-genealogy concept, reimplemented).
/// DERIVATION: the child lot was produced using the parent — a harvest
/// lot derived from the seed/fertiliser/pesticide lots consumed on its
/// field. SPLIT: one parent lot divided into several child lots. MERGE:
/// several parent lots combined into one. Phase 1 wires DERIVATION on
/// harvest; SPLIT/MERGE are reserved for repackaging/re-lotting.
enum LotLinkType {
  DERIVATION
  SPLIT
  MERGE
}

/// Review lifecycle for a `NewsDerivedEvent` (calendar roadmap PR 3 — AI
/// news-derived calendar events). PROPOSED is the only status the daily
/// extraction job ever writes; APPROVED/REJECTED are exclusively set by a
/// platform admin via POST /api/admin/news-derived-events/[id]/approve|
/// reject. The calendar loader reads ONLY APPROVED rows — a PROPOSED row
/// is invisible to every tenant until a human reviews it.
enum NewsDerivedEventStatus {
  PROPOSED
  APPROVED
  REJECTED
}

/// Review state of a government support scheme. Same three states as
/// NewsDerivedEventStatus and deliberately a separate enum: the two are
/// reviewed in different queues by different criteria, and sharing one enum
/// would make a future state that means something for one of them (say
/// SUPERSEDED for a measure whose window reopened) appear in the other.
enum SupportSchemeStatus {
  PROPOSED
  APPROVED
  REJECTED
}
