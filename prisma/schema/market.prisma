// ─────────────────────────────────────────────────────────────────────
// Market-price domain — GLOBAL, tenant-agnostic price cache.
//
// Generator + datasource remain in base.prisma; this file holds only the
// market-price model blocks. These tables are GLOBAL (no `tenantId`
// column), the same class as SoilSample / CadastreArchive / Unit: the
// cached price series are public reference data (EC AGRI-food open API,
// Alpha Vantage) or a k-anonymised cross-tenant aggregate — identical for
// every tenant. Because they carry no `tenantId`, the DMMF RLS
// auto-enroller in src/lib/db/rls-middleware.ts leaves them out of
// TENANT_SCOPED_MODELS — there is deliberately NO per-tenant RLS filter,
// exactly like `SoilSample`.
//
// The `source:'listings'` series is a cross-tenant WEEKLY MEDIAN over all
// tenants' ACTIVE ExchangeListings, suppressed below a k-anonymity floor
// of 3 distinct tenants — it stores only `{ count }` in point meta, never
// a listing id or tenant id. See src/app-layer/jobs/market-prices-pull.ts.
// ─────────────────────────────────────────────────────────────────────

/// GLOBAL cache of one market-price time series (NO tenantId — public
/// reference data / k-anonymised aggregate, identical for every tenant,
/// exactly like `SoilSample`). A series is the natural grouping the read
/// API splits a chart by: (source, commodity, region, stage). Upserted
/// idempotently on that natural key. `currency` + `unit` are per-series
/// and load-bearing — the EC oilseeds endpoint reports national-currency
/// prices (BG→BGN, RO→RON), so we NEVER normalise; the chart splits by
/// unit/currency instead.
model MarketPriceSeries {
  id        String    @id @default(cuid())
  /// Data origin: 'ec-agrifood' | 'alpha-vantage' | 'listings'.
  source    String
  /// Commodity slug: 'wheat' | 'maize' | 'barley' | 'sunflower'.
  commodity String
  /// Region: 'BG' | 'RO' | 'EL' | 'EU' | 'GLOBAL'.
  region    String
  /// Optional market stage (EC `stageName` / `marketStage`), e.g. a
  /// delivery/processing stage. Null for sources with no stage concept
  /// (Alpha Vantage, listings index).
  stage     String?
  /// Optional human label (product name / reference note).
  label     String?
  /// Price unit as reported by the source, e.g. 'EUR/t', 'USD/bu',
  /// 'BGN/t'. NOT normalised across sources.
  unit      String
  /// ISO currency of `price`, e.g. 'EUR' | 'BGN' | 'RON' | 'USD'.
  currency  String
  /// When a superuser CLEARED a platform price override (#1587). Null means
  /// the override is live; non-null means the run ended and the feed is
  /// authoritative again.
  ///
  /// Marked rather than deleted, per the #1587 contract 5(b): the typed history
  /// survives and so does the audit trail of what was typed. The read path
  /// excludes a cleared series, so "cleared" and "absent from the payload" are
  /// the same thing to a client without the rows going anywhere.
  ///
  /// Only ever set on `source: 'platform'` rows. A feed's series is never
  /// cleared — there is nobody to clear it and nothing it would mean.
  clearedAt DateTime?

  /// Where this series came from, for a per-series attribution a client can
  /// render (#3081) — «Източник: ZarnoBorsa.com».
  ///
  /// ON THE DATA rather than hard-coded in a client, because the attribution
  /// belongs to the series: a client that mapped `source` to a name would be
  /// a second table to keep in step, and a source added server-side would
  /// show as unattributed until every client shipped.
  ///
  /// Nullable, so every existing series is untouched. The EC and platform
  /// series carry none today; absence means "no link to offer", never "no
  /// source".
  sourceUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  points MarketPricePoint[]

  /// Natural key — one series per (source, commodity, region, stage,
  /// currency, unit) so the pull job upserts idempotently.
  ///
  /// currency + unit are PART OF IDENTITY, not attributes of it. They used to
  /// be outside the key and written only on create, so an upstream
  /// denomination change appended new-currency points to the old series under
  /// the old label — a BGN price rendered as EUR, mixed into a EUR history,
  /// on one axis, with no error anywhere. It happened, and was remediated by
  /// hand-written SQL. Now a change mints a NEW series and the old points
  /// keep the denomination they were actually quoted in.
  @@unique([source, commodity, region, stage, currency, unit])
}

/// GLOBAL dated observation on a MarketPriceSeries (NO tenantId — see the
/// series doc). Upserted idempotently on (seriesId, date) so re-running
/// the pull never duplicates a point.
model MarketPricePoint {
  id        String            @id @default(cuid())
  seriesId  String
  series    MarketPriceSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  /// Observation date (week-ending / month / day, per source). Date-only.
  date      DateTime          @db.Date
  price     Decimal           @db.Decimal(12, 2)
  /// Structured provenance — e.g. `{ count }` for the k-anonymised
  /// listings index (distinct-tenant count, never ids). Never free text.
  meta      Json?
  /// When the override RUN this point belonged to was cleared (#1587). Null
  /// means the point is part of the current run and is published.
  ///
  /// This is on the POINT and not only on the series, and the reason is the
  /// natural key. `(source, commodity, region, stage, currency, unit)` is
  /// UNIQUE, so re-typing after a clear resolves to the SAME series row — and
  /// un-clearing the series alone would republish every pre-clear point, which
  /// is exactly the resurrection the contract rules out. Found by agrent-ios
  /// before it shipped.
  ///
  /// A run-start date on the series was the alternative and it breaks on a
  /// BACKDATED correction: clear on the 10th, correct the 5th, and everything
  /// from the 6th to the 9th comes back. Stamping points means re-typing a date
  /// replaces that one point and brings only it into the new run, while dates
  /// nobody re-typed stay hidden.
  clearedAt DateTime?
  createdAt DateTime          @default(now())

  /// Idempotent-upsert key.
  @@unique([seriesId, date])
  /// FK index (schema-index Layer B).
  @@index([seriesId])
}

/// GLOBAL cache of one aggregated agricultural-news headline (NO tenantId —
/// public reference data aggregated from free Bulgarian agri RSS/Atom feeds +
/// ДФ Земеделие + EC agri press, identical for every tenant, exactly like
/// `MarketPriceSeries` / `SoilSample`). Feeds the Trends → News tab. Upserted
/// idempotently on `guidHash` (sha256 of the item's guid‖link) so a re-run of
/// the daily `market-news-pull` job never duplicates a headline; the job also
/// prunes rows whose `publishedAt` is older than 60 days.
model MarketNewsItem {
  id          String   @id @default(cuid())
  /// Origin feed slug, e.g. 'agri-bg' | 'dfz' | 'ec-agrifood'.
  source      String
  /// Bucket the News tab filters by: 'market' | 'policy' | 'general'. Assigned
  /// by the feed's default category, promoted by a deterministic BG+EN keyword
  /// match (see src/lib/news/categorize.ts).
  category    String
  /// Headline text (plain, sanitised — never raw HTML).
  title       String
  /// Short excerpt from the feed description (plain, sanitised). Nullable —
  /// some feeds ship title-only items.
  summary     String?
  /// Canonical article URL — the tap-through target.
  url         String
  /// Optional lead image (RSS enclosure / media:content).
  imageUrl    String?
  /// Publish time from the feed (pubDate / atom:updated). Drives feed order.
  publishedAt DateTime
  /// Inclusive topic + crop tags, several per article (#231).
  ///
  /// SEPARATE from `category`, which stays. `category` is exclusive and
  /// priority-ordered — policy beats market — because one field forced a
  /// choice. Tags remove the forcing: a subsidy story about wheat carries
  /// BOTH `subsidies` and `wheat`, and there is no precedence to apply.
  ///
  /// Empty is a real value rather than a gap. An article matching no rule
  /// carries `[]`, which is the honest answer and what the «Всички» switch
  /// keeps reachable.
  ///
  /// Crop tags ARE the commodity slugs, resolved through COMMODITY_ALIASES
  /// rather than a parallel keyword list — so one vocabulary serves news
  /// tagging and Борса search, and a new crop is added in one place. See
  /// `src/lib/news/categorize.ts`.
  tags        String[] @default([])
  /// Idempotent-upsert + dedupe key: sha256(guid || link).
  guidHash    String
  /// Last time the pull saw this item (refreshed on every upsert).
  fetchedAt   DateTime @default(now())
  /// First time the pull ingested this item.
  createdAt   DateTime @default(now())

  /// Idempotent-upsert / dedupe key.
  @@unique([guidHash])
  /// Backs the News read: filter by category, newest first.
  @@index([category, publishedAt])
  /// Backs the all-categories read: newest first + the 60-day prune scan.
  @@index([publishedAt])
  /// GIN — `tags hasSome [...]` is array containment, which a btree cannot
  /// serve. Declared here so the schema and the database agree; the index is
  /// also written explicitly in the migration.
  @@index([tags], type: Gin)
}

/// GLOBAL registry of one EXTERNAL DOCUMENT this product cites, watched for
/// revision (#3146, server half of agrent-ios#639). NO tenantId — a cited
/// publication is identical for every farm, the same class as
/// `MarketPriceSeries` above, so the DMMF RLS auto-enroller leaves it out of
/// TENANT_SCOPED_MODELS and there is deliberately no per-tenant filter.
///
/// ── Why it lives in market.prisma ──
///
/// It is not market-specific: the first population is the 13 documents the
/// AGRO CALENDAR cites, of which 12 are МЗХ and one is a seed company's
/// variety sheet. It sits here because this is the file whose header already
/// establishes the tenantless, no-RLS posture this model needs, and because
/// the largest series it watches — МЗХ's «Оперативен анализ» — is the same
/// publication `mzh-prices-pull` reads for the price series. `agro.prisma`
/// states in its own header that all of its models carry a NON-NULL
/// tenantId, which this one does not.
///
/// ── Why a flag and not an overwrite ──
///
/// `sha256` is the baseline: the bytes last ACCEPTED as what the citation
/// points at. When a check finds different bytes the job writes `changedAt` +
/// `changedSha256` and LEAVES `sha256` alone, because agrent-ios#639 asks for
/// a changed document to be flagged rather than silently replaced. Replacing
/// it would destroy the only record of what the figure was checked against —
/// and a cited document being revised means a published agronomic window may
/// no longer be supported by the page it names, which is the signal this
/// model exists to preserve rather than consume.
///
/// So a flagged row is STICKY and stays flagged until a human promotes the
/// new hash. That is deliberate and it is also this slice's known limit: the
/// only reader of the flag today is the job's own structured log. A console
/// or notification that lets a superuser acknowledge one is the next slice —
/// see #3146.
///
/// ── A CHECK the schema cannot express ──
///
/// The migration adds `source_document_watch_flag_is_complete`: the three
/// `changed*` columns are all null or all set. Prisma has no syntax for a
/// CHECK, so it lives in the migration only — the same arrangement as
/// `channel_post_says_something`. It matters because a row with `changedAt`
/// set and `changedSha256` null would read as "changed, hash unknown", and
/// the job compares against that column on its next run — so the partial
/// state would re-flag the document every day for ever.
model SourceDocumentWatch {
  id            String    @id @default(cuid())
  /// Absolute URL of the watched document. The natural key: the citation is
  /// what the calendar renders, and two citations may legitimately name one
  /// URL, so the DOCUMENT is the thing with one row.
  url           String    @unique
  /// The agro-calendar dataset's own citation slug — a key of
  /// `CALENDAR.sources`. Named `citation` and not `sourceKey` because that is
  /// what it is: a dataset citation, authenticating nothing.
  citation      String
  /// Publisher exactly as the dataset names it — `МЗХ`, `KWS`.
  publisher     String
  /// Which of agrent-ios#639's five series, when the URL classifies into one;
  /// null when it does not, because guessing is what #3136 measured as
  /// unreliable for this publisher.
  series        String?
  /// sha256 (hex) of the bytes last accepted as the baseline.
  sha256        String
  /// Byte length of the baseline, MEASURED from the body — never taken from
  /// `Content-Length`, which is the #3147 lesson one layer out.
  bytes         Int
  /// Content-Type the server reported for the baseline, verbatim and
  /// unparsed. A change here is a weaker signal than a hash change but it is
  /// the one that says a PDF became an HTML error page.
  contentType   String?
  firstSeenAt   DateTime  @default(now())
  /// When the document was last successfully OR unsuccessfully reached. Null
  /// only between the row being minted and the first check.
  lastCheckedAt DateTime?
  /// Outcome of the most recent check: `ok` | `unchanged` | `changed` |
  /// `unreachable` | `refused` | `too-large` | `empty`. A string and not an
  /// enum because the set is this job's own vocabulary and a migration per
  /// new outcome buys nothing.
  lastStatus    String?
  /// Set when a check found bytes hashing to something other than `sha256`.
  /// Null means the citation still points at the bytes we checked it against.
  changedAt     DateTime?
  /// The hash of the CHANGED bytes. Held beside the baseline rather than
  /// replacing it, so both are readable when somebody reviews the flag.
  changedSha256 String?
  /// Byte length of the changed document, measured the same way as `bytes`.
  changedBytes  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The flagged set is the query a review surface runs, and it is a tiny
  /// fraction of the table, so it gets its own index.
  @@index([changedAt])
  @@index([series])
}

/// The field campaign's progress from МЗХ's weekly «Оперативен анализ»
/// (#3173): one row per bulletin, holding its harvest and sowing tables as
/// parsed and checked against their own arithmetic (`mzh-progress.ts`).
/// GLOBAL reference data — no tenantId, the same as MarketPricePoint. The
/// phone's Табло reads the newest one.
model CampaignProgressSnapshot {
  id           String   @id @default(cuid())
  /// The bulletin's own date, from its filename. Unique, so re-reading a
  /// bulletin is an upsert rather than a second snapshot.
  bulletinDate DateTime @unique @db.Date
  /// The newest «към» date among its tables — what the figures describe.
  asOf         DateTime @db.Date
  sourceUrl    String
  /// `{ harvest: ProgressTable[], sowing: ProgressTable[] }`, as parsed. A
  /// document rather than columns: the tables change with the season, and
  /// only the newest snapshot is ever served.
  tablesJson   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([asOf])
}

/// A document FOUND on one of МЗХ's listing pages — agri-saas#3146, second
/// slice (the server half of agrent-ios#639: "a cron job for querying the МЗХ
/// for new series content every day").
///
/// `SourceDocumentWatch` watches what the calendar already CITES for revision;
/// this records what МЗХ PUBLISHES, so a new technology card, guide, support
/// order or «Аграрен доклад» is noticed the day it appears.
///
/// The first crawl of a listing records everything already on it as
/// `baseline` — known, never announced — so switching discovery on does not
/// mail years of back catalogue. From then on a URL not seen before is new,
/// and `notifiedAt` is stamped only after the owner's email went out (owner,
/// 2026-11-17: "email me").
///
/// Global like its sibling: a published МЗХ document is one fact for every
/// farm, so there is no tenant axis, and nothing about any person is held.
model SourceDocumentDiscovery {
  id          String    @id @default(cuid())
  /// Absolute URL of the document (a PDF, or a news item for the series that
  /// МЗХ announces only as news). The natural key.
  url         String    @unique
  /// Which watched series found it — the listing's own slug, never parsed out
  /// of the filename (#3154 measured МЗХ's filenames as unreliable).
  series      String
  /// The listing page it was found on.
  listingUrl  String
  /// The link text as МЗХ wrote it, for the email. Null when the link had none.
  title       String?
  /// Already on the listing at its first crawl: known, never announced.
  baseline    Boolean   @default(false)
  firstSeenAt DateTime  @default(now())
  /// When the owner's email naming it was sent. Null until a send succeeded.
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([series])
  @@index([notifiedAt])
}

/// One row per МЗХ listing page discovery has read at least once — agri-saas#3146.
///
/// Separate from the documents, because "this listing has been read" is not
/// "this listing has rows": the news list records only items that match a
/// watched series, so a first read with no match leaves no document behind —
/// and judging "first read" by rows would then baseline the first real
/// support order silently. A test caught exactly that.
model SourceListingRead {
  listingUrl  String   @id
  firstReadAt DateTime @default(now())
  lastReadAt  DateTime @default(now())
}
