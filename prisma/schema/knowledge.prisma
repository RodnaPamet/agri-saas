// ═══════════════════════════════════════════════════════════════════
//  KNOWLEDGE BASE — versioned SOPs + growing guides
// ═══════════════════════════════════════════════════════════════════
//
//  Repurposes IC's Policy machinery: KnowledgeArticle /
//  KnowledgeArticleVersion / KnowledgeAcknowledgement mirror Policy /
//  PolicyVersion / PolicyAcknowledgement, with a simpler
//  DRAFT→PUBLISHED→ARCHIVED lifecycle (no IN_REVIEW/APPROVED approval
//  workflow) and TipTap HTML content (sanitised on write). Workers READ
//  a published version and ACKNOWLEDGE it (tracked per version+user).
//
//  Deviation from the Policy mirror: all three tables carry `tenantId`
//  for the canonical direct-RLS trio (Policy's acknowledgement table is
//  ownership-chained). Consistent with the rest of the ag stack.
//
//  Back-relations added elsewhere (Prisma needs both sides):
//    • auth.prisma  Tenant: knowledgeArticles / knowledgeArticleVersions /
//                           knowledgeAcknowledgements
//    • auth.prisma  User:   KnowledgeArticleOwner / KnowledgeVersionCreator /
//                           knowledgeAcknowledgements
//
//  ─── Agronomy structure (`cropTags` / `regions` / `bbchStageMin+Max`) ───
//
//  `String[]` columns, not join tables. A join table (`KnowledgeArticleCrop`
//  FK'd to a canonical crop catalog) would need that catalog to be GLOBAL —
//  `KnowledgeChunk.tenantId` is nullable precisely because the GLOBAL
//  licensed catalog has no owning tenant, so a per-tenant `CropType` table
//  (the crop-planning module's model) cannot be the FK target without
//  re-introducing a tenant coupling the chunk model deliberately has none
//  of. A free-text join table would buy zero relational integrity over an
//  array column while adding a join to every retrieval query — and
//  retrieval (`ai/rag/retrieve.ts`) is latency-sensitive and already a
//  hybrid keyword+vector query with no article join today. Postgres native
//  arrays support `hasSome` filtering directly with no join. Empty array is
//  the documented sentinel for "applies to every crop / region" (avoids a
//  nullable-vs-empty ambiguity). `bbchStageMin/Max` is a min/max Int PAIR,
//  not an array of stages, because BBCH (00-99) is a continuous ordinal
//  scale and a SOP applies to a *range* of stages, not a discrete set.
//
//  Mirrored onto `KnowledgeChunk` below (denormalized, incl. `language`
//  which the chunk didn't otherwise carry): retrieval must filter a chunk
//  directly, never by joining back to `KnowledgeArticle` — see the
//  KnowledgeChunk header for why the retrieval query shape is a flat,
//  no-join predicate.
// ═══════════════════════════════════════════════════════════════════

/// A knowledge-base article — a versioned SOP or growing guide. The
/// published content is whatever `currentVersion` points at; DRAFT edits
/// live on the latest version until publish flips status + currentVersionId.
///
/// NULLABLE tenantId (W5 task) — the asymmetric-RLS twist, mirroring
/// `KnowledgeChunk` / `UserSession` / `IntegrationWebhookEvent`:
///   • tenantId NULL  → GLOBAL, platform-authored content (e.g. the
///                      satellite-imagery guide, seeded by
///                      `scripts/rag/ingest-satellite-guide.ts` under the
///                      superuser-bypassed default Prisma client — see
///                      that script's header). Readable by EVERY tenant;
///                      only a superuser-bypassed script may write one.
///   • tenantId set   → tenant-private, unchanged behaviour.
/// The single asymmetric policy (USING (NULL OR own) WITH CHECK (own)) is
/// mandatory — see migration 20260809130000_knowledge_global_articles and
/// the UserSession migration it mirrors. No tenant-facing usecase may
/// create, edit, publish, archive, unarchive, delete, or acknowledge a
/// GLOBAL article — enforced in `src/app-layer/usecases/knowledge.ts`
/// (`assertTenantOwned`); `KnowledgeAcknowledgement`'s composite FK to
/// `KnowledgeArticleVersion(id, tenantId)` independently rejects an
/// acknowledgement attempt at the DB layer too (a GLOBAL version's NULL
/// tenantId can never equal an acting tenantId).
model KnowledgeArticle {
  id               String                 @id @default(cuid())
  tenantId         String?
  /// Unique per tenant — used in readable URLs + as the seed upsert key.
  /// For GLOBAL (tenantId NULL) rows, `@@unique([tenantId, slug])` below
  /// does NOT enforce uniqueness — Postgres treats NULLs as distinct, so
  /// two GLOBAL rows could otherwise share a slug. A hand-authored partial
  /// unique index (`KnowledgeArticle_slug_global_key ON (slug) WHERE
  /// "tenantId" IS NULL`, in the migration — Prisma's DSL has no
  /// `@@unique(..., where: ...)`) covers that case; same hand-authored-SQL
  /// pattern as the `KnowledgeChunk.embedding` ivfflat index above.
  slug             String
  title            String
  summary          String?
  /// Free-text category for browse/filter (e.g. "Spraying", "Harvest").
  category         String?
  status           KnowledgeArticleStatus @default(DRAFT)
  currentVersionId String?                @unique
  ownerUserId      String?
  language         String?                @default("en")
  /// Provenance for seeded content (e.g. "OpenFarm" for CC0 growing guides).
  source           String?
  /// Crops this SOP/guide applies to (free-text slugs, e.g. "wheat",
  /// "sunflower"). Empty array = applies to every crop. `String[]`, not a
  /// join table — see the "Agronomy structure" note below.
  cropTags         String[]               @default([])
  /// Regions this SOP applies to (free-text, e.g. oblast names). Empty
  /// array = applies to every region. Same array-vs-join-table reasoning
  /// as `cropTags`.
  regions          String[]               @default([])
  /// BBCH growth-stage applicability range (00-99 ordinal scale), e.g.
  /// 30-39 = stem elongation. Both null = not stage-specific. A min/max
  /// pair (not an array of stages) because BBCH is a continuous ordinal
  /// scale and SOPs apply to a *range*, not a discrete set.
  bbchStageMin     Int?
  bbchStageMax     Int?
  /// Lifecycle counter (mirrors Policy.lifecycleVersion): 1 = initial,
  /// incremented on each publish.
  lifecycleVersion Int                    @default(1)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?
  deletedByUserId  String?
  retentionUntil   DateTime?

  tenant         Tenant?                   @relation(fields: [tenantId], references: [id])
  owner          User?                     @relation("KnowledgeArticleOwner", fields: [ownerUserId], references: [id])
  currentVersion KnowledgeArticleVersion?  @relation("KnowledgeCurrentVersion", fields: [currentVersionId], references: [id])
  versions       KnowledgeArticleVersion[] @relation("KnowledgeArticleVersions")
  chunks         KnowledgeChunk[]

  @@unique([id, tenantId])
  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
}

/// One immutable content snapshot of an article. New edits create a new
/// version (versionNumber++); publish points the article's currentVersion
/// at the chosen version. Acknowledgements attach to a specific version.
///
/// NULLABLE tenantId (W5 task) — mirrors `KnowledgeArticle.tenantId` above
/// (NULL = GLOBAL, same asymmetric-RLS policy, same write restriction).
/// `createdById` stays a required FK to `User` even for GLOBAL versions —
/// `scripts/rag/ingest-satellite-guide.ts` upserts one designated
/// "platform author" User row rather than allowing a null author, so
/// "who authored this" stays a real, displayable answer everywhere the UI
/// already shows `createdBy.name`.
model KnowledgeArticleVersion {
  id            String               @id @default(cuid())
  tenantId      String?
  articleId     String
  versionNumber Int
  contentType   KnowledgeContentType @default(HTML)
  contentText   String?
  changeSummary String?
  createdById   String
  createdAt     DateTime             @default(now())

  tenant           Tenant?                    @relation(fields: [tenantId], references: [id])
  article          KnowledgeArticle           @relation("KnowledgeArticleVersions", fields: [articleId], references: [id], onDelete: Cascade)
  currentOfArticle KnowledgeArticle?          @relation("KnowledgeCurrentVersion")
  createdBy        User                       @relation("KnowledgeVersionCreator", fields: [createdById], references: [id])
  acknowledgements KnowledgeAcknowledgement[]

  @@unique([id, tenantId])
  @@unique([articleId, versionNumber])
  @@index([tenantId])
  @@index([tenantId, articleId])
}

/// A worker's acknowledgement of a specific published article version
/// (read-receipt). One per (version, user) — re-acknowledging is a no-op.
///
/// Deliberately NOT nullable (W5 task) and still on the canonical
/// split-policy RLS pair — an acknowledgement always belongs to the
/// ACTING tenant, never to a GLOBAL one. Its composite FK below
/// (`[articleVersionId, tenantId] -> KnowledgeArticleVersion(id,
/// tenantId)`) requires an EXACT tenantId match, so it is structurally
/// impossible to acknowledge a GLOBAL (tenantId NULL) article version —
/// no row in `KnowledgeArticleVersion` ever has `tenantId = <a real
/// tenant id>` AND `id = <a GLOBAL version's id>`. The usecase layer
/// (`acknowledgeArticle`) rejects it first with a clear error; this FK is
/// the independent DB-layer backstop.
model KnowledgeAcknowledgement {
  id               String   @id @default(cuid())
  tenantId         String
  articleVersionId String
  userId           String
  acknowledgedAt   DateTime @default(now())

  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  articleVersion KnowledgeArticleVersion @relation(fields: [articleVersionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  user           User                    @relation(fields: [userId], references: [id])

  @@unique([articleVersionId, userId])
  @@index([tenantId, articleVersionId])
  @@index([tenantId, userId])
}

// ═══════════════════════════════════════════════════════════════════
//  RAG — retrieval-augmented knowledge chunks (feat/ai-rag)
// ═══════════════════════════════════════════════════════════════════
//
//  Grounds the general LLM in agricultural knowledge. Each row is a
//  short text passage + its embedding vector; `retrieve()` ranks them
//  by cosine distance + keyword match and feeds the top-K to the model
//  as numbered, citable sources.
//
//  NULLABLE tenantId — the asymmetric-RLS twist (mirrors UserSession /
//  IntegrationWebhookEvent):
//    • tenantId NULL  → GLOBAL catalog: licensed external corpora
//                       (KCC, FAIR-Forward QA, EU/USDA organic) ingested
//                       by `scripts/rag/ingest-corpus.ts`. Readable by
//                       EVERY tenant; only the superuser-bypassed
//                       ingestion script may write a NULL-tenant row.
//    • tenantId set   → tenant-private: that tenant's own journal /
//                       crop-plan / label / KB chunks. Readable + writable
//                       only by its owning tenant.
//  The single asymmetric policy (USING (NULL OR own) WITH CHECK (own))
//  is mandatory: a split INSERT policy would be a permissive sibling
//  that lets app_user re-tenant a NULL row. See the migration
//  20260619100000_ai_rag_pgvector + the UserSession migration rationale.
//
//  The `embedding` column is `vector(768)` (pgvector). Prisma cannot
//  model it, so it is declared `Unsupported(...)` here and the real
//  column type + the ivfflat cosine index are hand-authored in the
//  migration. All vector I/O goes through src/lib/db/embeddings.ts via
//  raw $executeRaw / $queryRaw (mirrors the PostGIS geometry pattern).
//
//  Back-relations added elsewhere (Prisma needs both sides):
//    • auth.prisma      Tenant:           knowledgeChunks
//    • knowledge.prisma KnowledgeArticle: chunks
// ═══════════════════════════════════════════════════════════════════
model KnowledgeChunk {
  id         String                   @id @default(cuid())
  /// NULL = GLOBAL licensed catalog; non-null = tenant-private. See header.
  tenantId   String?
  /// Optional FK → the source KnowledgeArticle (KB chunks). Null for
  /// tenant-data (journal/crop-plan/label) and external/global chunks.
  articleId  String?
  /// Human-readable provenance + licence label, e.g. "KCC (GODL)".
  source     String
  sourceType KnowledgeChunkSourceType
  /// The originating record id (LogEntry id, external doc id, …).
  sourceRef  String?
  text       String                   @db.Text
  chunkIndex Int                      @default(0)
  /// BCP-47-ish language tag (e.g. "bg", "en") mirrored from the owning
  /// KnowledgeArticle at chunk-creation time — KB chunks always carry it;
  /// external/journal/crop-plan chunks may be null (language unknown).
  /// Lets retrieval prefer the caller's language WITHOUT a join back to
  /// KnowledgeArticle (see ai/rag/retrieve.ts).
  language   String?
  /// Mirrored from KnowledgeArticle at chunk-creation time — see the
  /// "Agronomy structure" note on KnowledgeArticle above for why these
  /// are arrays/a range rather than a join table. Empty array = applies
  /// to every crop/region; both null = not stage-specific.
  cropTags     String[] @default([])
  regions      String[] @default([])
  bbchStageMin Int?
  bbchStageMax Int?
  /// pgvector `vector(768)` (nomic-embed-text dims). Prisma can't model
  /// it — real column + ivfflat index live in the migration; writes/reads
  /// go through src/lib/db/embeddings.ts raw SQL.
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  tenant  Tenant?           @relation(fields: [tenantId], references: [id])
  article KnowledgeArticle? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  // Layer A (tenantId-leading) + the articleId FK in the 2nd slot.
  @@index([tenantId, articleId])
  // Backs the language-aware retrieval WHERE clause (ai/rag/retrieve.ts) —
  // a real equality predicate, unlike the array/text filters above which
  // stay unindexed (see the KnowledgeChunk LIST_MODELS_TENANT_INDEX_SUFFICIENT
  // entry in tests/guardrails/schema-index-coverage.test.ts).
  @@index([tenantId, language])
}
