// ─────────────────────────────────────────────────────────────────
//  GAP-09 — multi-file schema: AUTOMATION & INTEGRATIONS
//
//  Owns:
//    • AutomationRule + AutomationExecution + AutomationEvent
//      (Epic 60 event-driven backbone)
//    • IntegrationConnection + IntegrationCredential
//    • SyncMapping (per-practice external-entity mapping)
//    • Webhook + WebhookDelivery (outbound integrations)
//    • Notification + NotificationPreference + NotificationDelivery
//    • NotificationRule + NotificationDispatchLog
//
//  Why a dedicated file: automation is the integration boundary —
//  it touches every domain's events but owns no business state of
//  its own beyond rule definitions and execution traces. Putting it
//  in its own file keeps the rule-engine surface auditable in
//  isolation from the domain models it observes.
//
//  This file is currently empty. Models will land here in a focused
//  follow-up PR.
// ─────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  read      Boolean          @default(false)
  linkUrl   String?
  // Optional idempotency key for job-generated notifications. Mirrors
  // `NotificationOutbox.dedupeKey` — a unique key shaped
  // `{tenantId}:{type}:{entityId}:{userId}:{YYYY-MM-DD}` so a job
  // that re-runs (retry, redeploy) within the same UTC day trips the
  // unique index instead of creating a duplicate. Left NULL by
  // interactive/event-driven notification writers, which don't dedupe.
  dedupeKey String?          @unique
  createdAt DateTime         @default(now())
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  @@index([tenantId, userId])
}

// A browser/device Web Push subscription owned by a tenant member. One row
// per (user, endpoint) — a user with two devices has two rows. Tenant-scoped
// → carries the canonical RLS trio (see the migration). Dead endpoints
// (410/404 on send) are pruned by the push sender.
model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // tenant-leading so a browser subscribed under two tenants keeps a row per
  // tenant (and the index serves the per-recipient [tenantId, userId] lookup
  // the push sender does).
  @@unique([tenantId, userId, endpoint])
}

model ReminderHistory {
  id         String   @id @default(cuid())
  tenantId   String
  evidenceId String
  type       String
  sentAt     DateTime @default(now())
  evidence   Evidence @relation(fields: [evidenceId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model NotificationOutbox {
  id               String                @id @default(cuid())
  tenantId         String
  type             EmailNotificationType
  toEmail          String
  subject          String
  bodyText         String
  bodyHtml         String?
  status           EmailOutboxStatus     @default(PENDING)
  attempts         Int                   @default(0)
  lastError        String?
  sendAfter        DateTime              @default(now())
  createdAt        DateTime              @default(now())
  sentAt           DateTime?
  dedupeKey        String                @unique
  toEmailEncrypted String?
  tenant           Tenant                @relation(fields: [tenantId], references: [id])

  @@index([status, sendAfter])
  @@index([tenantId])
}

model TenantNotificationSettings {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  enabled           Boolean  @default(true)
  defaultFromName   String   @default("Inflect Compliance")
  defaultFromEmail  String   @default("noreply@inflect.app")
  complianceMailbox String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
}

model UserNotificationPreference {
  id        String               @id @default(cuid())
  userId    String
  tenantId  String
  delivery  NotificationDelivery @default(IMMEDIATE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  user      User                 @relation(fields: [userId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model IntegrationConnection {
  id              String                   @id @default(cuid())
  tenantId        String
  provider        String
  name            String
  isEnabled       Boolean                  @default(true)
  configJson      Json                     @default("{}")
  secretEncrypted String?
  lastTestedAt    DateTime?
  lastTestStatus  String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  executions      IntegrationExecution[]
  syncMappings    IntegrationSyncMapping[]

  @@unique([tenantId, provider, name])
  @@index([tenantId])
  @@index([tenantId, provider])
}

model IntegrationExecution {
  id            String                     @id @default(cuid())
  tenantId      String
  connectionId  String?
  provider      String
  automationKey String
  status        IntegrationExecutionStatus @default(PENDING)
  resultJson    Json?
  evidenceId    String?
  errorMessage  String?
  durationMs    Int?
  triggeredBy   String                     @default("scheduled")
  jobRunId      String?
  executedAt    DateTime                   @default(now())
  completedAt   DateTime?
  createdAt     DateTime                   @default(now())
  connection    IntegrationConnection?     @relation(fields: [connectionId], references: [id])
  tenant        Tenant                     @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, automationKey])
  @@index([tenantId, status])
  @@index([jobRunId])
}

model IntegrationWebhookEvent {
  id           String    @id @default(cuid())
  tenantId     String?
  provider     String
  eventType    String?
  payloadJson  Json
  headersJson  Json?
  payloadHash  String?
  status       String    @default("received")
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
  receivedAt   DateTime  @default(now())
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([provider, receivedAt])
  @@index([provider, payloadHash, createdAt])
  @@index([status])
}

// Note: @@map is deliberately omitted here to conform to the repository's 
// global Prisma convention. All models use Prisma's default exact-case tables
// (e.g., 'IntegrationSyncMapping' instead of 'integration_sync_mappings').
// The isolated AuthSession model mapped strictly to "Session" remains an anomaly.
model IntegrationSyncMapping {
  id                String                 @id @default(cuid())
  tenantId          String
  provider          String
  connectionId      String?
  localEntityType   String
  localEntityId     String
  remoteEntityType  String
  remoteEntityId    String
  syncStatus        SyncStatus             @default(PENDING)
  lastSyncDirection SyncDirection?
  conflictStrategy  ConflictStrategy       @default(REMOTE_WINS)
  localUpdatedAt    DateTime?
  remoteUpdatedAt   DateTime?
  remoteDataJson    Json?
  /// SP-3 — remote accessible URL (e.g. SharePoint DriveItem webUrl) for a
  /// "View in source" link on the local entity. Provider-agnostic.
  sourceUrl         String?
  version           Int                    @default(1)
  errorMessage      String?
  lastSyncedAt      DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  connection        IntegrationConnection? @relation(fields: [connectionId], references: [id])
  tenant            Tenant                 @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider, localEntityType, localEntityId])
  @@unique([tenantId, provider, remoteEntityType, remoteEntityId])
  @@index([tenantId, provider])
  @@index([tenantId, syncStatus])
  @@index([connectionId])
}

model AutomationRule {
  id                  String                @id @default(cuid())
  tenantId            String
  name                String
  description         String?
  /// The event name this rule subscribes to. Free-form string so new
  /// events can be emitted without a migration; the canonical catalog
  /// lives at src/app-layer/automation/events.ts so typos are caught
  /// at the producer side, not here.
  triggerEvent        String
  /// Optional filter expression (e.g. `{ severity: "CRITICAL" }`).
  /// Evaluated by the dispatcher against the event payload before any
  /// action fires. `null` means "match every event of this type".
  triggerFilterJson   Json?
  actionType          AutomationActionType
  /// Action-specific config. Shape depends on `actionType`:
  ///   NOTIFY_USER       → { userIds: string[], message: string }
  ///   CREATE_TASK       → { title, severity, assigneeUserId? }
  ///   UPDATE_STATUS     → { entityType, field, toStatus }
  ///   WEBHOOK           → { url, method, headers?, secretRef? }
  actionConfigJson    Json
  status              AutomationRuleStatus  @default(DRAFT)
  /// Higher priority runs first when multiple rules match the same
  /// event. Ties broken by `createdAt`.
  priority            Int                   @default(0)
  /// Cheap dashboard counters. Incremented by the dispatcher; never
  /// the source of truth (AutomationExecution is).
  executionCount      Int                   @default(0)
  lastTriggeredAt     DateTime?
  /// SLA window (Epic 5): max minutes between an execution starting and
  /// resolving before it's a breach. `null` = no SLA. The sla-monitor job
  /// scans RUNNING executions past this window and fires the breach action.
  slaWindowMinutes    Int?
  /// Optional reminder lead time (minutes before breach). Reserved for the
  /// reminder sweep; the monitor reads it but reminder fan-out is a follow-up.
  slaReminderMinutes  Int?
  /// Action fired on breach + its config.
  slaBreachActionType AutomationActionType?
  slaBreachConfigJson Json?
  /// Chained workflow (Epic 7): fire `nextRule` after this rule succeeds,
  /// optionally after `nextRuleDelay` minutes. A DFS cycle guard in the
  /// usecase prevents loops. `null` = terminal rule.
  nextRuleId          String?
  nextRuleDelay       Int?
  /// PR-F — the ELSE branch. When a chained rule's own `triggerFilter` does
  /// NOT match the payload at chain time, the chain follows `elseRuleId`
  /// instead of `nextRuleId` (and the rule's action is skipped). This makes
  /// the canvas condition-pass / condition-fail edges executable.
  elseRuleId          String?
  /// PR-E — schedule config for time-based triggers (triggerEvent = 'SCHEDULE').
  /// Shape: { kind: 'DATE_RELATIVE', target: 'Evidence', offsetDays: number }.
  /// (The ControlException / ControlTestPlan targets went with the
  /// compliance exoskeleton — see schedule-trigger-sweep.ts.) The sweep fires the
  /// rule N days before the target entity's due date. null for event-triggered
  /// rules.
  scheduleConfigJson  Json?
  /// VR-7 — when this rule belongs to a canvas sub-flow group, the enclosing
  /// group's ProcessNode.nodeKey. The governance graph (VR-10) reads this to
  /// draw sub-flow-call relationships between maps. No FK — the group node
  /// lives in a ProcessMap, not a constrainable table.
  subFlowGroupId      String?
  createdByUserId     String?
  updatedByUserId     String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  /// Soft-delete. Archived rules stop firing but their execution
  /// history survives for audit.
  deletedAt           DateTime?

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  executions    AutomationExecution[]
  nextRule      AutomationRule?       @relation("RuleChain", fields: [nextRuleId], references: [id])
  prevRules     AutomationRule[]      @relation("RuleChain")
  elseRule      AutomationRule?       @relation("RuleElseChain", fields: [elseRuleId], references: [id])
  elsePrevRules AutomationRule[]      @relation("RuleElseChain")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, triggerEvent])
  @@index([tenantId, deletedAt])
  @@index([tenantId, triggerEvent, status])
  @@index([nextRuleId])
  @@index([elseRuleId])
  @@index([tenantId, subFlowGroupId])
}

model AutomationExecution {
  id                 String                    @id @default(cuid())
  tenantId           String
  ruleId             String
  /// Denormalised copy of the rule's trigger event at fire time so
  /// the event-feed index below stays single-column and the row is
  /// still readable if the rule is later archived.
  triggerEvent       String
  /// Snapshot of the event payload that matched. Kept verbatim for
  /// replay + audit — the shape depends on the event producer.
  triggerPayloadJson Json
  status             AutomationExecutionStatus @default(PENDING)
  /// Action output (e.g. created task ids, notified user ids, webhook
  /// response code). Shape mirrors the rule's `actionType`.
  outcomeJson        Json?
  errorMessage       String?
  errorStack         String?
  durationMs         Int?
  /// Correlation to the observability job-run span so ops can trace a
  /// specific execution in logs / traces / metrics.
  jobRunId           String?
  /// What caused the fire. `event` for normal event-bus dispatch,
  /// `manual` for admin-triggered replay, `schedule` for cron
  /// re-evaluation of pending rules.
  triggeredBy        String                    @default("event")
  /// Deduplication handle. The dispatcher computes this from
  /// (ruleId, event, stable identifier in payload) so a retried
  /// event never double-fires an action. Unique per tenant when set.
  idempotencyKey     String?
  /// Chained-workflow lineage (Epic 7): the execution that triggered this
  /// one via a rule chain. `null` for top-level (event/manual) executions.
  parentExecutionId  String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                  @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  rule   AutomationRule @relation(fields: [ruleId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, ruleId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([ruleId, createdAt])
  @@index([triggerEvent, createdAt])
  @@index([jobRunId])
  @@index([tenantId, parentExecutionId])
}

// ── Process maps (relocated from processes.prisma) ───────────────────
//
// These are the AUTOMATION RULE BUILDER'S STORAGE, not a GRC surface:
// `services/canvas-rule-sync.ts` and the rule-builder components read and
// write them. They arrived with the inherited GRC product alongside a
// `/processes` page, and that page is going — but the models stay, because
// automation is a live agri feature (Epic 60).
//
// A pure move: no field, index or relation changed. `ProcessEdgePractice`
// keeps its bare nullable `practiceId` String (it has no `@relation`, so
// processes never had an FK into the compliance surface); that column is
// dropped in the teardown's phase 3.

model ProcessMap {
  id              String            @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  status          ProcessMapStatus  @default(DRAFT)
  /// VR-2 — DOCUMENT (process maps, existing) vs AUTOMATION (visual rule
  /// editor). Gates the palette, inspector, edge kinds, and toolbar.
  canvasMode      ProcessCanvasMode @default(DOCUMENT)
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  // Incremented on every successful save. PR-A's repo layer
  // bumps it on every `replaceGraph`. Frontend reads it back for
  // future optimistic-concurrency hints (e.g. "the canvas was
  // edited by someone else — reload?"). NOT yet enforced as a
  // hard optimistic lock at the repo layer — that is a forward
  // affordance the column reserves.
  version         Int               @default(1)
  // Soft-delete slot — list queries filter on `deletedAt IS NULL`.
  // Hard-delete is available via the DELETE endpoint when the
  // caller has the canAdmin permission.
  deletedAt       DateTime?
  deletedByUserId String?

  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  createdBy User                 @relation("ProcessMapCreatedBy", fields: [createdByUserId], references: [id])
  deletedBy User?                @relation("ProcessMapDeletedBy", fields: [deletedByUserId], references: [id])
  nodes     ProcessNode[]
  edges     ProcessEdge[]
  snapshots ProcessMapSnapshot[]

  @@unique([id, tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
}

// ─────────────────────────────────────────────────────────────────
//  Epic P5-PR-A — ProcessMapSnapshot.
//
//  Stores the full graph JSON for every committed version of a
//  process map so the version-history sidebar can list snapshots
//  + future P5-PR-B can render any earlier version + diff between
//  two snapshots. Per-version one row keyed on (processMapId,
//  version); the unique constraint guarantees no duplicates if a
//  retry of `replaceGraph` ever fires.
//
//  Tenant isolation: direct-scoped RLS (Class A) added in the
//  paired migration. The (id, tenantId) composite + cascading
//  FK to ProcessMap keep cross-tenant references structurally
//  impossible.
//
//  `graphJson` carries the same shape the canvas sends on save:
//    { version, nodes: [...], edges: [...] }
//  The route layer never decodes the inner shape; the client
//  re-parses on view-version + diff renders.
// ─────────────────────────────────────────────────────────────────
model ProcessMapSnapshot {
  id              String   @id @default(cuid())
  tenantId        String
  processMapId    String
  version         Int
  graphJson       Json
  createdAt       DateTime @default(now())
  createdByUserId String

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  processMap ProcessMap @relation(fields: [processMapId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy  User       @relation("ProcessMapSnapshotCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([processMapId, version])
  @@index([tenantId, processMapId, version])
  @@index([tenantId, createdAt])
}

model ProcessNode {
  id            String   @id @default(cuid())
  tenantId      String
  processMapId  String
  // Client-stable id (e.g. "node-1") — distinct from the row's
  // cuid `id`. Persists across saves so the frontend can keep
  // xyflow selections + camera focus stable when the user clicks
  // Save. Unique per process map.
  nodeKey       String
  // Canonical node-type key. PR-A only ships "processStep" (the
  // only node type R25 introduced). PR-B widens this to the full
  // taxonomy.
  nodeType      String
  label         String
  subtitle      String?
  posX          Float
  posY          Float
  // R30 — optional parent reference for the "group" kind. References
  // the parent's per-map `nodeKey` (the frontend-stable id), NOT the
  // row's cuid `id`. The rest of the graph (ProcessEdge.sourceKey /
  // targetKey) already references node KEYS — keeping `parentNodeKey`
  // on the same kind lets the frontend round-trip xyflow's `parentId`
  // (which references the xyflow node id, which IS our nodeKey)
  // without translation.
  //
  // No FK constraint: the parent must exist in the SAME processMap
  // row-set; `replaceGraph` validates this structurally. Migration
  // adds a partial index on `(processMapId, parentNodeKey)` for the
  // "find all children of this group" query.
  parentNodeKey String?
  // Forward-compatible per-type payload. PR-B uses this to carry
  // typed metadata for richer node kinds (practice owner, risk
  // severity, asset criticality) without further migrations.
  dataJson      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  processMap ProcessMap @relation(fields: [processMapId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([processMapId, nodeKey])
  @@index([tenantId, processMapId])
}

model ProcessEdge {
  id            String   @id @default(cuid())
  tenantId      String
  processMapId  String
  // Client-stable edge id. Same rationale as ProcessNode.nodeKey.
  edgeKey       String
  // References the source + target *node keys* (not row ids), so
  // a save → reload round-trip preserves the graph even if the
  // server re-mints row ids for any reason. The repo layer
  // ensures both keys exist among the map's nodes at save time.
  sourceKey     String
  targetKey     String
  // "flow" is the default. PR-D introduces governance-aware edge
  // kinds (e.g. "data-flow" vs "approval-flow") via this column.
  // VR-5 — AUTOMATION-mode edge kinds also ride this column (no
  // migration — it's a free String): "trigger-flow", "condition-pass",
  // "condition-fail", "chain-delay", "sla-breach", "sla-pass". The
  // canonical set + inference lives in src/lib/processes/edge-kind-inference.ts.
  edgeKind      String   @default("flow")
  labelOverride String?
  dataJson      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  processMap ProcessMap           @relation(fields: [processMapId, tenantId], references: [id, tenantId], onDelete: Cascade)
  practices   ProcessEdgePractice[]

  @@unique([processMapId, edgeKey])
  @@unique([id, tenantId])
  @@index([tenantId, processMapId])
}

model ProcessEdgePractice {
  id           String   @id @default(cuid())
  tenantId     String
  // Denormalised from the parent ProcessMap so RLS can scope every
  // table on the same column shape. The composite FK to the parent
  // ProcessEdge already binds (edgeId, tenantId) — denormalising
  // processMapId in addition keeps "all practices in map X" a
  // direct indexed query.
  processMapId String
  edgeId       String
  // Client-stable id, scoped to the edge.
  practiceKey   String
  label        String
  // Free-form payload for the edge-mounted practice card. This used
  // to sit below a nullable `practiceId` FK pointing at the GRC
  // `Practice` table; GRC teardown phase 3 dropped both that column
  // and its table, so a process-map practice is now identified by
  // `practiceKey` + `label` alone and has no row to point at.
  dataJson     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  edge   ProcessEdge @relation(fields: [edgeId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([edgeId, practiceKey])
  @@index([tenantId, processMapId])
}
