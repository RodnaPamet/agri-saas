// ═══════════════════════════════════════════════════════════════════
//  JOURNAL DOMAIN — Phase 1: the field record (LogEntry + LogQuantity)
// ═══════════════════════════════════════════════════════════════════
//
//  Design lineage: farmOS log-type ontology + Quantity (GPL-2.0 —
//  CONCEPTS ONLY, reimplemented; no code copied; license-hygiene
//  guardrail enforces).
//
//  Phase-1 scope is deliberately narrow: enough journal to make a spray
//  job a compliant, inventory-accurate field record. When an
//  OperationParcel is marked DONE the field-operation usecase emits one
//  INPUT_APPLICATION LogEntry (the spray record) + a LogQuantity (the
//  applied amount), and the StockTransaction it drives points back at
//  the LogEntry. The full journal (LogLocation/LogEquipment/LogPlanting
//  /LogEntryFile link tables, a quick-entry UI, PLANNED-as-task) is
//  deferred — see docs/implementation-notes for the cut line.
//
//  Back-relations added elsewhere (Prisma needs both sides):
//    • auth.prisma        Tenant:   logEntries LogEntry[]
//    • auth.prisma        User:     LogEntryCreator
//    • agriculture.prisma OperationParcel: logEntries LogEntry[]
//    • agriculture.prisma Unit:     logQuantities LogQuantity[]
//    • inventory.prisma   StockTransaction.logEntry → LogEntry
// ═══════════════════════════════════════════════════════════════════

/// A field event — the durable record of work done (or planned) on the
/// farm. INPUT_APPLICATION is the traceability-critical spray/fertiliser
/// record; free text runs through sanitizePlainText() at the usecase
/// boundary like every write path (Epic D.2).
model LogEntry {
  id                String         @id @default(cuid())
  tenantId          String
  type              LogEntryType
  status            LogEntryStatus @default(DONE)
  /// When the event happened. Time matters for spray records.
  occurredAt        DateTime
  /// The entry's title as a READER sees it, and for an auto-generated entry
  /// this is a RENDERING, not the source of truth — see `titleKey`.
  ///
  /// Always populated, in every case, because it is what every existing
  /// consumer reads: the list column, the detail breadcrumb, the native
  /// client, and the typed-confirm purge in `DeletedJournalView`, which
  /// requires the operator to retype this exact string to arm a permanent
  /// delete. A nullable title would break that gesture in a way no type
  /// error would catch.
  title             String
  /// Descriptor for an AUTO-GENERATED title: the i18n key under
  /// `journal.autoTitle.*`, with `titleParams` supplying its values.
  ///
  /// Null for anything a person wrote. Non-null means `title` was composed by
  /// the server, and a reader that can resolve the key SHOULD, because the
  /// language a row is read in is not knowable where the row is written —
  /// the rule `CLAUDE.md` already states for `DueItem.reason` and outbound
  /// email. This is the same shape applied to a PERSISTED value.
  ///
  /// Why not just store the rendered string: an input application was
  /// recorded as `Applied ${product} to ${parcel}` in English, and 11 of 16
  /// live entries carried one (#1073). Fixing the composer alone would have
  /// left those rows English forever, because a rendered sentence keeps no
  /// trace of what it was rendered FROM.
  ///
  /// **Cleared on edit.** `updateLogEntry` nulls both columns when a person
  /// changes the title, because the descriptor would otherwise go on
  /// asserting a composition that no longer describes the text. An edited
  /// entry is operator-authored, whatever it started as.
  titleKey          String?
  /// Values for `titleKey`. Ids and quantities only — never personal data,
  /// the same rule notification params carry.
  titleParams       Json?
  notes             String?
  /// Spray-record compliance fields (wind, temp, operator cert no.,
  /// REI/PHI). JSON until the certification module promotes what
  /// schemes require.
  conditionsJson    Json?
  /// The spray prescription line this record was emitted from (simple
  /// FK — OperationParcel has no [id, tenantId] barrier). Lets the job
  /// answer "what did this application consume?".
  operationParcelId String?
  /// Ekylibre intervention-cost concept (reimplemented): optional
  /// cost of this field event, for per-activity costing later.
  costAmount        Decimal?       @db.Decimal(14, 2)
  costCurrency      String?
  /// Free-form structured attributes (e.g. the async photo pest/disease
  /// ID result under `pestId`). Distinct from `conditionsJson` (spray
  /// compliance fields).
  attributesJson    Json?
  /// "Try it with sample data" tag — see Location.isSampleData
  /// (agriculture.prisma). Default-false; reversible via clearSampleData.
  isSampleData      Boolean        @default(false)
  /// This entry was recorded by a person IN the diary, even though it carries
  /// an `operationParcelId` (#1740).
  ///
  /// Needed because `operationParcelId` stopped being a sufficient test. The
  /// journal list shows manual entries only — owner ruling 2026-10-10, in
  /// `JournalRepository._buildWhere` — and that rule read the FK as proof a
  /// row came from a task. The two-step treatment record breaks the
  /// equivalence: it is typed by a person in the diary and still writes
  /// operation lines, because those lines are what the BABH diary PDF reads.
  ///
  /// So the FK now answers "is this linked to an operation line" and this
  /// column answers "did a person record it here" — the same question until
  /// it was not.
  ///
  /// Default-false is the safe direction: every existing row, and anything
  /// `recordInputApplication` writes from a completed task line, keeps the
  /// visibility the 2026-10-10 ruling gave it. Only a writer that sets this
  /// deliberately becomes visible.
  recordedInDiary   Boolean        @default(false)
  /// The key the ДНЕВНИК list folds on (#1740).
  ///
  /// A treatment writes one entry per operation line — twelve parcels in
  /// three blocks is twelve entries — and the register shows ONE row per
  /// treatment. This carries that treatment's handle, the same value as
  /// `Task.treatmentGroupId`, so the fold needs no join: the handle is
  /// otherwise reachable only as
  /// `LogEntry.operationParcelId -> OperationParcel.taskId -> Task`, and
  /// folding across a join would mean reimplementing the journal's
  /// manual-only WHERE clause in raw SQL. One spelling of that rule is worth
  /// a denormalised column; it took a DB-backed test to pin down, because
  /// Prisma's `NOT: { a, b }` is not obvious.
  ///
  /// NOT NULL, and an entry that belongs to no treatment gets its OWN unique
  /// value, so it folds to itself and needs no second code path. That is not
  /// tidiness: `DISTINCT ON` treats all NULLs as ONE value, so a nullable key
  /// would collapse every manual entry a farm has ever written into a single
  /// ghost row — measured, 4 null rows returning 1. The Дневник is the
  /// launch screen, so that is the whole list for a farm with no treatments
  /// yet, which today is every farm.
  ///
  /// Denormalised, so it can in principle go stale. It cannot here: the only
  /// writer is `recordDiaryTreatment`, which sets it in the same transaction
  /// as the lines. Worth naming rather than discovering.
  treatmentGroupId  String         @default(uuid())
  /// Offline exactly-once handle. When a journal entry is created from the
  /// queued outbox, the client's outbox-item id rides in as the
  /// `Idempotency-Key`; a replayed write (flaky rural LTE re-send) dedupes on
  /// (tenantId, clientMutationId) and returns the original entry instead of a
  /// duplicate. Nullable + NULLS-DISTINCT: online creates without a key are
  /// unconstrained (every NULL is unique to Postgres). Mirrors Task.clientMutationId.
  clientMutationId  String?
  /// Optimistic lock for OFFLINE EDITS (#919). An edit queued in a field
  /// captures the version it saw and replays it as `If-Match`; the server
  /// 409s a stale write instead of clobbering a supervisor's later change.
  /// Mirrors OperationParcel.version, including the 0 default.
  version           Int            @default(0)
  /// The Idempotency-Key of the last UPDATE applied to this row.
  ///
  /// Deliberately NOT reusing `clientMutationId`: that column is under
  /// @@unique([tenantId, clientMutationId]) and holds the CREATE's key, so
  /// writing an update's key there would destroy create-dedupe. Deliberately
  /// NOT unique either — this is an equality check, not a constraint.
  ///
  /// Without it, a replay after a lost response carries the version the
  /// operator saw BEFORE their own write landed, the version guard fails on
  /// their own success, and the outbox parks a conflict asking them to resolve
  /// keep-mine vs take-server against themselves. #913 fixed exactly that for
  /// parcel marks by comparing status; a journal body has too many fields for
  /// that to be sound, so the mutation id is the honest handle.
  lastMutationId    String?
  createdByUserId   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  deletedByUserId   String?

  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  operationParcel OperationParcel?   @relation(fields: [operationParcelId], references: [id])
  createdBy       User?              @relation("LogEntryCreator", fields: [createdByUserId], references: [id])
  quantities      LogQuantity[]
  stockTx         StockTransaction[]
  locations       LogLocation[]
  equipment       LogEquipment[]
  files           LogEntryFile[]
  /// Plan-vs-actual links — this entry realises a planting milestone.
  plantings       LogPlanting[]
  /// Lot-genealogy edges recorded by a HARVEST entry (provenance link).
  lotLinks        LotLink[]
  /// The yield record a HARVEST entry minted, when the farmer asked for the
  /// harvest to count as production as well as stock. At most one — see
  /// YieldRecord.logEntryId.
  yieldRecord     YieldRecord?

  @@unique([id, tenantId])
  // Offline idempotency ledger — a replayed journal-entry create dedupes here.
  // Nullable column ⇒ NULLS DISTINCT ⇒ online (no-key) creates never collide;
  // only real Idempotency-Key replays are constrained. Mirrors Task.
  @@unique([tenantId, clientMutationId])
  @@index([tenantId, type, occurredAt])
  @@index([tenantId, status, occurredAt])
  @@index([tenantId, operationParcelId])
  @@index([tenantId, treatmentGroupId])
}

/// farmOS Quantity: measure + value + unit + label. A spray record
/// carries the applied amount (e.g. { VOLUME 42.5 "L applied" }).
/// Cascade-deleted with its LogEntry.
model LogQuantity {
  id         String          @id @default(cuid())
  tenantId   String
  logEntryId String
  measure    QuantityMeasure
  value      Decimal         @db.Decimal(18, 6)
  unitId     String
  label      String?

  logEntry LogEntry @relation(fields: [logEntryId, tenantId], references: [id, tenantId], onDelete: Cascade)
  unit     Unit     @relation("LogQuantityUnit", fields: [unitId], references: [id])

  @@index([tenantId, logEntryId])
  @@index([tenantId, unitId])
}

// The `Equipment` model was retired here — it had ZERO write paths
// anywhere in the repo (no create/createMany/upsert in src/, prisma/,
// or scripts/, seeds included), so its pickers were permanently empty
// and the tractor on /assets could never be the tractor on a field
// operation. Machines now live in `Asset` (compliance.prisma), which
// already carries the AST-N keys, soft-delete/trash/restore/purge, the
// audit trail, RLS, assignment notifications and a detail page. Its two
// useful columns (`meterValue`, `attributesJson`) moved with it.
// See the migration for the fail-loud COUNT guard.

/// Link: a LogEntry happened at a Location (the Feature-1 field block).
model LogLocation {
  id         String @id @default(cuid())
  tenantId   String
  logEntryId String
  locationId String

  logEntry LogEntry @relation(fields: [logEntryId, tenantId], references: [id, tenantId], onDelete: Cascade)
  location Location @relation(fields: [locationId, tenantId], references: [id, tenantId])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([logEntryId, locationId])
  @@index([tenantId, locationId])
}

/// Link: a LogEntry used a machine. Points at `Asset` since the
/// `Equipment` merge — same `[id, tenantId]` composite-FK style as
/// `LogLocation`, so a link can never cross tenants.
model LogEquipment {
  id         String @id @default(cuid())
  tenantId   String
  logEntryId String
  assetId    String

  logEntry LogEntry @relation(fields: [logEntryId, tenantId], references: [id, tenantId], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId, tenantId], references: [id, tenantId])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([logEntryId, assetId])
  @@index([tenantId, assetId])
}

/// Link: a photo / document attached to a LogEntry via the existing
/// FileRecord pipeline (HortusFox-style photo logging). FileRecord has
/// no [id, tenantId] barrier → simple FK; isolation via tenantId + RLS.
model LogEntryFile {
  id           String   @id @default(cuid())
  tenantId     String
  logEntryId   String
  fileRecordId String
  caption      String?
  createdAt    DateTime @default(now())

  logEntry   LogEntry   @relation(fields: [logEntryId, tenantId], references: [id, tenantId], onDelete: Cascade)
  fileRecord FileRecord @relation("LogEntryFileRecord", fields: [fileRecordId], references: [id])
  tenant     Tenant     @relation(fields: [tenantId], references: [id])

  @@unique([logEntryId, fileRecordId])
  @@index([tenantId, logEntryId])
}

/// The treatment as a ROW, so a correction has something to commit in (#2172).
///
/// ## Why this exists at all
///
/// A treatment has always been a SHARED HANDLE rather than a thing:
/// `treatmentGroupId` is one value carried on N `Task` rows and N `LogEntry`
/// rows, indexed on both, with no row of its own. That is enough to FOLD the
/// ДНЕВНИК list and enough to withdraw a treatment, and it was deliberately
/// not more.
///
/// It is not enough to CORRECT one, and #2172 recorded exactly why:
///
///   - **Nothing to commit in.** The existing write is atomic PER BLOCK, not
///     across the treatment — #1740's explicit decision, where a partial
///     failure leaves the committed blocks recorded and the replay path
///     finishes the job. A correction has no replay path, so a partial
///     correction would leave the register matching NEITHER the old nor the new
///     definition. On a regulated document that is worse than a refusal.
///   - **Nowhere to put a version.** `OperationParcel.version` is per ROW, and
///     a correction may ADD or DROP a parcel or a product, so "all N row
///     versions must match" has no stable N to compare against. That is the
///     iOS session's argument and it is the sharp form of the problem.
///
/// Owner ruling 2026-10-24: give the group a row. One thing to lock, one
/// version to bump, one owner for the correction trail.
///
/// ## The id is the HANDLE, not a new identifier
///
/// `@id` with no default: the value comes from the existing
/// `Task.treatmentGroupId` / `LogEntry.treatmentGroupId`. Minting a second
/// identifier would mean two spellings of one thing and a join to get from
/// either table to the group.
///
/// A plain `String` rather than a uuid column, because the handle is not always
/// a uuid: `Task.treatmentGroupId`'s own docblock records that its value is the
/// request's `Idempotency-Key` when one is sent and a server-minted UUID
/// otherwise, which lets a client derive the handle before the response
/// arrives.
///
/// ## No FK from LogEntry, deliberately
///
/// `LogEntry.treatmentGroupId` is NOT NULL and an entry belonging to no
/// treatment gets its OWN unique value — so it folds to itself and the Дневник
/// needs no second code path. (A nullable key would be worse than untidy:
/// `DISTINCT ON` treats all NULLs as ONE value, which was measured collapsing
/// 4 manual entries into 1 ghost row.) So most `LogEntry.treatmentGroupId`
/// values name no treatment and an FK would refuse every manual journal entry.
///
/// The discriminator for a real treatment is `Task.treatmentGroupId IS NOT
/// NULL`: only `recordDiaryTreatment` writes it, and it is null for every task
/// that is not part of a diary treatment.
model TreatmentGroup {
  /// The shared handle — see the model note. No default: the caller supplies it.
  ///
  /// NOT a primary key on its own: the handle is unique PER TENANT, not
  /// globally. `Task.treatmentGroupId`'s value can be the request's
  /// `Idempotency-Key`, and idempotency keys are scoped
  /// `@@unique([tenantId, clientMutationId])` — so two farms can legitimately
  /// send the same key and a global `@id` would make the backfill violate its
  /// own primary key on exactly that data. `@@id([tenantId, id])` below, which
  /// is also the `[id, tenantId]` idiom `Parcel` and `Item` already use for
  /// composite references.
  id        String
  tenantId  String
  /// Bumped by ANY write to the group or to one of its lines (#2172).
  ///
  /// Distinct from `OperationParcel.version`, which stays per row and keeps
  /// serving the offline parcel-mark replay. This one answers a different
  /// question — "has the treatment's DEFINITION moved under me" — which a
  /// per-row version cannot, because a correction can change the row set.
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  corrections TreatmentCorrection[]

  @@id([tenantId, id])
  @@index([tenantId, updatedAt])
}

/// One correction to a recorded treatment. APPEND-ONLY (#2172).
///
/// ## The whole previous definition, never a diff
///
/// Owner ruling 2026-10-24, and the iOS session's argument for it: a diff makes
/// a reader reconstruct a regulated record. `previous` carries the treatment's
/// complete definition as it stood before the correction, so reading the trail
/// never requires replaying anything.
///
/// ## `changedFields` labels without freezing a taxonomy
///
/// Three `OperationParcel` columns are deliberately point-in-time, each with
/// written no-backfill reasoning: `quarantinePeriodDays` (nothing records what
/// the period WAS), `phenophase` (a plausible guess would make a regulated
/// document authoritative about something nobody observed), and `treatedAreaHa`
/// (NULL means the WHOLE parcel). Correcting a mistyped observation is
/// different in kind from correcting the product or the dose: one restates what
/// was observed, the other fixes a record of what happened.
///
/// So the names of the changed fields are stored and the CLASSIFICATION is not.
/// A reader can label a correction "one observation, one fact" from the names,
/// and which fields count as observations can change later without a migration
/// and without re-labelling history that cannot be re-derived.
model TreatmentCorrection {
  id                String   @id @default(cuid())
  tenantId          String
  groupId           String
  /// The treatment's COMPLETE definition before this correction.
  previous          Json
  /// Top-level field names that changed. See the model note on why the kind is
  /// derived from these rather than stored.
  changedFields     String[]
  correctedAt       DateTime @default(now())
  /// Null when the actor is not a user session — the same convention as
  /// `deletedByUserId` elsewhere. Authorship on a farm record, so it is covered
  /// by the farm's own retention duty rather than by tenantless erasure.
  correctedByUserId String?

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  /// Composite, matching the group's tenant-scoped key. This is also what makes
  /// a correction unable to point at another tenant's treatment: the FK itself
  /// carries the tenant, so a mismatched pair has no referent rather than
  /// relying on the RLS policy alone to notice.
  group  TreatmentGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, groupId])
  @@index([tenantId, correctedAt])
}
