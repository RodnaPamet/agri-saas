/// The farm asset register.
///
/// `Asset` is the machine register behind `/assets`: the standalone
/// `Equipment` model was merged into it, so this is what the journal's
/// equipment picker and the machinery-depreciation cost line read.
/// `AssetMaintenance` is its service history and `AssetKeySequence` mints its
/// human-readable keys.
///
/// Moved here from `compliance.prisma` as a pure move. NOTE:
/// `AssetMaintenance.vendorId` is the single nullable FK crossing into the
/// doomed GRC surface; it becomes a dropped column in the teardown's phase 3.

model Asset {
  id                  String               @id @default(cuid())
  tenantId            String
  /// Generated per-tenant short key (`AST-1`, `AST-2`, …) so the
  /// Assets list page can lead with a scannable Code column.
  /// Mints atomically via `AssetKeySequence.upsert` (same race-
  /// free pattern Task / Risk use). Nullable to keep historic
  /// rows renderable; the create-path generates a key for every
  /// new row.
  key                 String?
  name                String
  type                AssetType
  /// Free-text operator/keeper name (legacy owner column). The
  /// structured assignee is `ownerUserId`.
  owner               String?
  /// Free-text location note. Retained alongside the structured
  /// `locationId` for unstructured detail ("north shed, back bay") that
  /// a Location row does not model. Structured lookups use `locationId`.
  location            String?
  /// Structured location — where this machine physically lives.
  /// `[id, tenantId]` composite FK, the same barrier Parcel uses, so a
  /// machine can never reference another tenant's yard. Makes "which
  /// machines are at the Dobrich yard" a query instead of a string match.
  locationId          String?
  /// Agricultural asset attributes (machines, buildings, equipment).
  manufacturer        String?
  model               String?
  serialNumber        String?
  /// Year of manufacture / construction.
  year                Int?
  purchaseDate        DateTime?
  /// Purchase price in the tenant's currency (2dp). Mapped to a
  /// plain `number` at the DTO boundary.
  purchaseCost        Decimal?             @db.Decimal(12, 2)
  /// Engine hours / odometer reading. Merged in from the retired
  /// `Equipment` model (which had zero rows and no write path) —
  /// machines now live in `Asset` so the tractor on the /assets page
  /// is the same row as the tractor on a field operation.
  meterValue          Decimal?             @db.Decimal(12, 1)
  /// Free-form machine attributes carried over from `Equipment`.
  attributesJson      Json?
  /// Useful life in years, the denominator of straight-line
  /// depreciation. Null means "not depreciated" — the /costs machinery
  /// basis reports such an asset as UNALLOCATED rather than charging
  /// zero, because a silent zero is indistinguishable from "free".
  usefulLifeYears     Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  ownerUserId         String?
  criticality         Criticality?
  status              AssetStatus          @default(ACTIVE)
  externalRef         String?
  deletedAt           DateTime?
  deletedByUserId     String?
  ownerUser           User?                @relation("AssetOwner", fields: [ownerUserId], references: [id])
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  // Evidence attached directly to this asset (Evidence Library tag +
  // the asset Evidence tab). Mirrors Practice/Task.
  evidence            Evidence[]
  /// Journal entries this machine was used on. Repointed from the
  /// retired `Equipment` model.
  logLinks            LogEquipment[]
  /// Service / repair / inspection / breakdown history.
  maintenance         AssetMaintenance[]
  /// Where the machine lives (structured).
  locationRef         Location?            @relation(fields: [locationId, tenantId], references: [id, tenantId])

  /// Unique within a tenant — `AST-N` collisions are race-free
  /// via the AssetKeySequence counter.
  @@unique([tenantId, key])
  /// Composite target for the journal link tables' `[id, tenantId]`
  /// FK style — the same barrier `Location` / `Parcel` / the retired
  /// `Equipment` carry, so a link can never cross tenants.
  @@unique([id, tenantId])
  @@index([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, type])
  @@index([tenantId, criticality])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  /// Backs the machine-register query (`listEquipment`): filter by
  /// tenant + machine-shaped `type`, excluding RETIRED `status`.
  @@index([tenantId, type, status])
  /// "Which machines are at this yard" — the query the free-text
  /// `location` column could never answer.
  @@index([tenantId, locationId])
}

/// Service / repair / inspection / breakdown history for a machine.
///
/// `AssetStatus.IN_MAINTENANCE` existed as a status with nothing behind
/// it — no record of what was done, when, at what meter reading, or what
/// it cost. This is that record, and it is the tab a farm actually wants
/// on an asset: Evidence / Mappings / Traceability are compliance-era
/// surfaces that a plain-farm tenant has gated off entirely.
model AssetMaintenance {
  id             String               @id @default(cuid())
  tenantId       String
  assetId        String
  kind           AssetMaintenanceKind
  openedAt       DateTime             @default(now())
  /// Null while the work is still open. Closing the LAST open record is
  /// what offers to put the asset back to ACTIVE.
  closedAt       DateTime?
  /// Engine hours / odometer at the time of service, so "hours since
  /// last service" is answerable independently of the asset's current
  /// `meterValue`.
  meterAtService Decimal?             @db.Decimal(12, 1)
  /// Sanitised at the usecase layer (Epic C.5) — this is decrypted and
  /// re-rendered by the detail page, PDF export and any future SDK
  /// consumer, so sanitising at render time alone would not be enough.
  description    String?
  cost           Decimal?             @db.Decimal(12, 2)
  /// Who did the work, when it was a third party.
  /// Next service due — by DATE and/or by METER. Modelled now even
  /// though nothing reads them yet: they are what makes a service-due
  /// signal possible later, and back-filling them onto history is far
  /// worse than carrying two nullable columns.
  nextDueAt      DateTime?
  nextDueMeter   Decimal?             @db.Decimal(12, 1)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  createdByUserId String?

  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("AssetMaintenanceCreator", fields: [createdByUserId], references: [id])

  @@index([tenantId, assetId])
  @@index([tenantId, assetId, openedAt])
  /// Open-record lookup: "does this asset still have work in progress?"
  @@index([tenantId, closedAt])
}

/// Per-tenant monotonic counter for minting `AST-N` asset keys.
/// Mirrors `TaskKeySequence` / `RiskKeySequence` — `upsert` with
/// an atomic `increment` is race-free under concurrent imports.
model AssetKeySequence {
  tenantId  String @id
  lastValue Int    @default(0)
}

// ─────────────────────────────────────────────────────────────────
// Daily metrics rollup.
//
// Moved here from `compliance.prisma` as a PURE MOVE (Prisma's
// `prismaSchemaFolder` concatenates the folder, so relocating a model
// between files produces no migration). It sits with `Asset` because the
// surviving reader that matters most is the `/assets` KPI sparkline strip —
// see §8f of docs/implementation-notes/2026-08-12-grc-teardown-plan.md for why
// this model came OFF the teardown's KILL list.
//
// The `practices*` / `policies*` / `vendors*` / `findingsOpen` columns below
// are DEAD as of phase 2: nothing computes or reads them any more. They are
// dropped in the phase-3 destructive migration (with its `.down.sql` inverse)
// rather than in a second migration here.
// ─────────────────────────────────────────────────────────────────
/// Daily compliance KPI snapshot for trend reporting.
/// One row per tenant per day. Idempotent via @@unique([tenantId, snapshotDate]).
/// Stores denormalized KPI values computed by the daily snapshot job.
/// Phase 3 dropped the practice / policy / vendor / finding COLUMNS from
/// this model. The model itself stays (plan §8f): it held 49 real
/// historical rows at the time of the drop, and the surviving evidence /
/// task / asset aggregates are what jobs/snapshot.ts still writes.
model ComplianceSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  /// Calendar date (midnight UTC) — NOT a full timestamp.
  /// Enables clean GROUP BY / ORDER BY for trend queries.
  snapshotDate DateTime @db.Date

  // ── Evidence ──
  evidenceTotal      Int @default(0)
  evidenceOverdue    Int @default(0)
  evidenceDueSoon7d  Int @default(0)
  evidenceDueSoon30d Int @default(0)
  evidenceCurrent    Int @default(0)

  // ── Tasks ──
  tasksTotal   Int @default(0)
  tasksOpen    Int @default(0)
  tasksOverdue Int @default(0)

  // ── Assets ──
  assetsTotal           Int @default(0)
  assetsActive          Int @default(0)
  assetsHighCriticality Int @default(0)
  assetsRetired         Int @default(0)

  // ── Meta ──
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, snapshotDate])
  @@index([tenantId, snapshotDate])
  @@index([tenantId])
}
