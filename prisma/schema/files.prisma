/// Documents — file records and the evidence that references them.
///
/// `FileRecord` backs the БАБХ ДНЕВНИК farm-record register
/// (`farm-record-register.ts`, `jobs/farm-record-pdf.ts`). `Evidence` fronts
/// the "Docs" nav surface at `/evidence` and carries the file links;
/// `EvidenceReview` is its review trail.
///
/// The three live together because they are one domain — a document, what it
/// evidences, and who reviewed it — and because `Evidence` holds the
/// `FileRecord` relation. Moved here from `compliance.prisma` as a pure move.

model FileRecord {
  id                String           @id @default(cuid())
  tenantId          String
  pathKey           String           @unique
  originalName      String
  mimeType          String
  sizeBytes         Int
  sha256            String
  status            FileRecordStatus @default(PENDING)
  /// #2062 — the ORIGINAL this row was derived from, by its `sha256`.
  ///
  /// Set on a thumbnail and null on everything else, which is why it is
  /// optional rather than backfilled. A farm photograph is stored twice: the
  /// 1600px original the farm selected, and a display-sized thumbnail the
  /// public grid renders. This column is the only thing that says which
  /// thumbnail belongs to which original.
  ///
  /// A HASH and not a `FileRecord` id, deliberately. The projection, the
  /// public media route and `FarmBrand.photoMediaHashes` all address images by
  /// content hash; an id here would mean the one place that pairs them spoke a
  /// different language from everywhere else that identifies them.
  ///
  /// NOT a foreign key, for the same reason `sha256` is not unique: two
  /// tenants can upload the same image, so a hash does not name one row. It
  /// names bytes, and the pairing is scoped by the tenant whose rows are being
  /// read.
  ///
  /// Generalised past photographs on purpose — `derivedFrom`, not
  /// `thumbnailOf`. A future PDF preview or a different size wants the same
  /// relationship, and the name should not have to be rewritten for it.
  derivedFromSha256 String?

  uploadedByUserId     String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  storedAt             DateTime?
  bucket               String?
  domain               String         @default("general")
  scanStatus           String         @default("PENDING")
  storageProvider      String         @default("local")
  scanDetails          String?
  scannedAt            DateTime?
  deletedAt            DateTime?
  deletedByUserId      String?
  retentionUntil       DateTime?
  evidence             Evidence[]
  farmDocuments             FarmDocument[]
  tenant               Tenant         @relation(fields: [tenantId], references: [id])
  uploadedBy           User           @relation("FileUploader", fields: [uploadedByUserId], references: [id])
  // Epic G-4 — campaigns whose evidence PDF this row carries.
  accessReviews        AccessReview[] @relation("AccessReviewEvidence")
  // Agriculture (Feature 1) — locations whose original spatial file
  // (shapefile/KML/GeoJSON) this row stores.
  locationSpatialFiles Location[]     @relation("LocationSpatialFile")
  logEntryFiles        LogEntryFile[] @relation("LogEntryFileRecord")
  costEntries          CostEntry[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, scanStatus])
  @@index([tenantId, deletedAt])
  /// #1812 — the public media route's only query, on the hash this table has
  /// ALWAYS carried. Tenantless on purpose: that route has no tenant in scope
  /// (it serves a public page), and the authorisation to serve comes from a
  /// projection referencing the hash, not from this index.
  @@index([sha256])
  /// #2062 — how the projection writer finds a photograph's thumbnail. It
  /// looks up every original in one query under the tenant's own RLS context,
  /// so the index leads with the tenant the way the others on this table do.
  @@index([tenantId, derivedFromSha256])
}

model Evidence {
  id                String            @id @default(cuid())
  tenantId          String
  // Source task — set when this evidence was uploaded/linked from a
  // task's Evidence tab. Powers the task Evidence tab AND the
  // "uploaded from" back-reference on the evidence detail surface.
  taskId            String?
  // Source asset — same pattern as taskId: set when uploaded from that
  // entity's Evidence tab; powers the attached-evidence tab + the
  // "uploaded from" back-reference.
  assetId           String?
  type              EvidenceType
  title             String
  content           String?
  fileName          String?
  fileSize          Int?
  category          String?
  dateCollected     DateTime          @default(now())
  owner             String? // Legacy free-text — kept for backward compat
  ownerUserId       String? // Real user FK — used for due-item routing & notifications
  reviewCycle       ReviewCadence?
  nextReviewDate    DateTime?
  status            EvidenceStatus    @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  deletedByUserId   String?
  fileRecordId      String?
  expiredAt         DateTime?
  isArchived        Boolean           @default(false)
  retentionDays     Int?
  retentionPolicy   RetentionPolicy   @default(NONE)
  retentionUntil    DateTime?
  /// B8 follow-up — free-text folder label (e.g. "SOC2/2026" or
  /// "Quarterly access reviews"). Mirrors the `VendorDocument.folder`
  /// pattern. Nullable; null/empty maps to "no folder" in the UI.
  /// Sanitised + trimmed at the usecase boundary.
  folder            String?
  /// Phase-8 — auto-evidence provenance. When a farm journal record
  // their proof here.
  task              Task?             @relation(fields: [taskId], references: [id])
  asset             Asset?            @relation(fields: [assetId], references: [id])
  fileRecord        FileRecord?       @relation(fields: [fileRecordId], references: [id])
  ownerUser         User?             @relation("EvidenceOwner", fields: [ownerUserId], references: [id])
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  reviews           EvidenceReview[]
  reminderHistories ReminderHistory[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId, retentionUntil])
  @@index([tenantId, isArchived])
  @@index([tenantId, ownerUserId])
  // GAP-perf — supports `status` filter (DRAFT|SUBMITTED|APPROVED|REJECTED).
  @@index([tenantId, status])
  // Supports the task Evidence tab ("evidence for task X") + the
  // evidence "uploaded from" back-reference lookup.
  @@index([tenantId, taskId])
  // Same, for the risk + asset Evidence tabs.
  @@index([tenantId, assetId])
  // GAP-perf — supports `type` filter (FILE|LINK|TEXT|SCREENSHOT).
  @@index([tenantId, type])
  // B8 follow-up — supports folder filter + group-by reads. Same
  // shape as VendorDocument's folder index.
  @@index([tenantId, folder])
  // Phase-8 — auto-evidence idempotency + "farm records backing this
  // scheme" lookup (FK-shaped scalar; Layer-B index coverage).
  // Calendar (compliance-calendar loadEvidenceEvents) — the
  // evidence-review range predicate had no index; every calendar load
  // was a per-tenant seq scan of Evidence.
  @@index([tenantId, nextReviewDate])
}

model EvidenceReview {
  // denorm-tenantId — Phase 2: tenantId is NOT NULL and the parent
  // relation is composite (evidenceId, tenantId) → Evidence(id,
  // tenantId), which structurally guarantees this row's tenantId
  // matches its parent's. Phase 3 swaps the chained RLS policy for
  // the trivial direct form.
  id         String       @id @default(cuid())
  tenantId   String
  evidenceId String
  reviewerId String
  action     ReviewAction
  comment    String?
  createdAt  DateTime     @default(now())
  evidence   Evidence     @relation(fields: [evidenceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  reviewer   User         @relation(fields: [reviewerId], references: [id])
  tenant     Tenant       @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, evidenceId])
}

/// A farm's document library row (#2495).
///
/// ## Why this is a thin row over `FileRecord`
///
/// `FileRecord` already carries the bytes' metadata — `pathKey`, `mimeType`,
/// `sizeBytes`, `sha256` — and a `FileRecordStatus` that already includes
/// `DELETED`. So this model holds only what a document IS beyond its bytes:
/// its title, its retention, its Drive copy and its tombstone. Same shape as
/// `Evidence` in this file, for the same reason.
///
/// ## There is deliberately NO `deletedAt`
///
/// The tombstone IS the record of deletion: a manual delete sets `purgedAt`,
/// `purgeReason = DELETED` and `purgedByUserId`, and clears `name`. Adding a
/// soft-delete column beside that would be two mechanisms for one fact, and
/// the list deliberately SHOWS tombstones — a farm needs to know a contract
/// expired, and that its Drive copy survives — so there is nothing for a
/// `deletedAt` filter to hide. Models carrying `deletedAt` also acquire
/// soft-delete semantics through `classification.ts`, which would then be a
/// second lifecycle on top of this one.
///
/// ## `name` is encrypted; on a manual delete it is CLEARED
///
/// A document title is routinely «Договор аренда <фамилия>.pdf» — third-party
/// personal data — so it is in `ENCRYPTED_FIELDS`. Owner ruling 2026-10-30:
/// an EXPIRED tombstone KEEPS the name, because expiry is policy and the
/// farm's index of what it held is the point; a DELETED tombstone clears it,
/// because a manual delete is a person's intent and is very often "this was
/// the wrong file". Keeping it would preserve indefinitely the one field
/// encrypted *because* it names third parties.
model FarmDocument {
  id               String                @id @default(cuid())
  tenantId         String

  /// Display title. ENCRYPTED. Null once a DELETED tombstone has cleared it.
  name             String?

  /// The stored bytes. Stays set on a tombstone, pointing at a `FileRecord`
  /// moved to `DELETED` — so "what was this file" survives without the bytes.
  fileRecordId     String
  uploadedByUserId String

  /// The retention period AS IT WAS AT UPLOAD.
  ///
  /// Stored per document, not read from the tenant setting at display time.
  /// `expiresOn` alone loses WHY that date was given: with the period, a row
  /// can say «Пази се 1 година, до …», and an audit can tell a 1-year
  /// document from a 2-year one uploaded a year earlier. It is also what
  /// makes a settings change unable to touch existing documents.
  retention        DocumentRetention

  /// Expiry as a CALENDAR DAY KEY (`YYYY-MM-DD`), null for «Без срок».
  ///
  /// A day key and not a `DateTime`, deliberately. The concept is a calendar
  /// date, so a timestamp would carry information the concept does not have
  /// and every reader would then decide which day it meant. `calendar-day-key
  /// .ts` states the rule: "lexicographic order IS calendar order, and there
  /// is no Date arithmetic to get wrong at a DST boundary." The sweep is then
  /// a string compare against `farmToday()`, and the expiry is integer month
  /// arithmetic with month-end clamping — neither has a timezone to get
  /// wrong. Computed in `FARM_TIME_ZONE` (Europe/Sofia), never
  /// `NOTIFICATIONS_TZ`, which defaults to Europe/London.
  ///
  /// The migration adds a CHECK constraint on the shape, so a malformed key
  /// cannot be written by any path.
  expiresOn        String?

  /// Set when the bytes were deleted. ONE field for every tombstone, whatever
  /// the reason — `purgeReason` carries the distinction. Two fields for one
  /// fact is how a client ends up reading whichever is populated.
  purgedAt         DateTime?
  purgeReason      DocumentPurgeReason?
  /// Who, when a person did it. Null when `EXPIRED`.
  purgedByUserId   String?

  /// Caller-supplied dedup key, so a retried upload cannot create a second
  /// document. Enforced by a PARTIAL unique index
  /// `(tenantId, idempotencyKey) WHERE idempotencyKey IS NOT NULL` — raw SQL
  /// in the migration, because Prisma cannot express the WHERE. NULL for an
  /// upload whose client sent no `Idempotency-Key`, and those are never
  /// deduplicated: two deliberate uploads of the same PDF are two documents.
  ///
  /// Added in step 2 rather than step 1 (#2503) because step 1 shipped the
  /// table without it while the step-2 contract specifies the header. An
  /// accepted-but-ignored `Idempotency-Key` is worse than none: it tells the
  /// client a retry is safe when it is not.
  idempotencyKey   String?

  driveState       DocumentDriveState    @default(OFF)
  /// The Drive file id, so a copy can be verified or re-pointed. Never a URL.
  driveFileId      String?
  driveCopiedAt    DateTime?
  /// Automatic retries before the row goes FAILED and an admin sees «Опитай пак».
  driveAttempts    Int                   @default(0)

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileRecord       FileRecord            @relation(fields: [fileRecordId], references: [id])
  uploadedBy       User                  @relation("FarmDocumentUploader", fields: [uploadedByUserId], references: [id])
  purgedBy         User?                 @relation("FarmDocumentPurger", fields: [purgedByUserId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  /// The list: newest first within a tenant.
  @@index([tenantId, purgedAt])
  @@index([tenantId, driveState])
  /// The SWEEP runs across tenants — `expiresOn <= today AND purgedAt IS NULL`
  /// — so it needs a non-tenant-leading index. Layer A only requires that AT
  /// LEAST one index leads with `tenantId`; this is an addition, not a
  /// replacement.
  @@index([expiresOn, purgedAt])
  @@index([fileRecordId])
  @@index([uploadedByUserId])
  @@index([purgedByUserId])
}

/// One-per-tenant document settings (#2495).
///
/// A fourth singleton of the shape `FarmProfile`'s docblock documents —
/// `tenantId @unique`, RLS trio in the migration, no soft-delete — rather
/// than fields bolted onto `TenantModuleSettings`, whose own columns
/// (`enabledModules`, `meteobotStationUrl`) are a different concern.
///
/// The per-tenant byte ceiling is NOT here: it is an env var, so changing it
/// is a restart rather than a migration, and it applies whatever the plan.
/// `PLAN_LIMITS` would have been inert — `STRIPE_SECRET_KEY` is absent on the
/// VM, so every tenant resolves to ENTERPRISE and every ENTERPRISE limit is
/// null.
model TenantDocumentSettings {
  id         String            @id @default(cuid())
  tenantId   String            @unique
  /// Applies to NEW uploads only; each document carries its own period.
  retention  DocumentRetention @default(P1Y)
  /// Turning this off stops new copies. It does NOT revoke the Google
  /// connection, which the ДНЕВНИК export still uses.
  driveSync  Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
