// ─────────────────────────────────────────────────────────────────────
// Exchange domain — cross-tenant agriculture marketplace.
//
// Generator + datasource remain in base.prisma; this file holds only the
// Exchange model blocks. The Exchange DELIBERATELY breaks the normal
// one-tenant-per-row rule: tenants must read EACH OTHER's offers, so these
// tables are GLOBAL (no `tenantId` column), the same class as Unit /
// Framework / Org*. Because they carry no `tenantId`, the DMMF RLS
// auto-enroller in src/lib/db/rls-middleware.ts leaves them out of
// TENANT_SCOPED_MODELS — reads are global, no per-tenant RLS filter.
//
// The `sellerTenantId` / `inquirerTenantId` columns are PLAIN foreign keys
// (they hold a Tenant.id) — intentionally NOT declared as Prisma
// `@relation`s, so the tables stay decoupled and global and so the
// FK-index guardrail (Layer B) doesn't force tenant-composite indexes.
//
// ── The two halves are NOT the same ──────────────────────────────────
// This header used to say the Exchange had no RLS at all. That was true
// of both tables and correct for only one of them.
//
//   * ExchangeListing — GLOBAL, no RLS, by design. Cross-tenant
//     readability IS the product; it carries no private data
//     (`description` / `sellerDisplayName` are sanitised public
//     plaintext). Recorded as an explicit exemption in
//     tests/guardrails/rls-coverage.test.ts so the next reader finds a
//     decision rather than an omission.
//
//   * ExchangeInquiry — PRIVATE buyer↔seller messages, and now
//     RLS-protected on a parallel axis keyed on `inquirerTenantId`, the
//     same footing as PromotionLead and the Organization layer. See
//     migration 20260728120000_exchange_inquiry_rls. Because an inquiry
//     has TWO legitimate parties, the policy is a disjunction: the
//     inquirer, OR the seller resolved through the listing.
//
// Usecase-layer write guards (`ctx.tenantId === listing.sellerTenantId`)
// remain the primary control and are unchanged. RLS is the backstop, so
// a forgotten `where` in a future repository method cannot expose one
// tenant's private messages to another.
// ─────────────────────────────────────────────────────────────────────

/// Global cross-tenant marketplace offer (no tenantId → not tenant-scoped,
/// no RLS). A SELL listing offers a commodity; a BUY listing seeks one.
/// `description` + `sellerDisplayName` are PUBLIC, sanitized plaintext
/// (NOT encrypted — every tenant can read them). Write access is guarded in
/// the usecase layer by `ctx.tenantId === sellerTenantId`.
model ExchangeListing {
  id                String                @id @default(cuid())
  /// Owning tenant — plain FK to Tenant.id (NOT a tenantId RLS column).
  sellerTenantId    String
  /// User within the seller tenant who created the listing.
  sellerUserId      String
  side              ExchangeSide
  /// Product class (#11) — CULTURE / FERTILIZER / SEEDS / PRODUCT. Existing
  /// rows backfill to CULTURE (crops) in the migration.
  kind              ExchangeKind          @default(CULTURE)
  commodity         String
  quantityTonnes    Decimal               @db.Decimal(14, 3)
  pricePerTonne     Decimal?              @db.Decimal(12, 2)
  priceCurrency     String                @default("BGN")
  /// Bulgaria oblast code (ISO 3166-2 style, e.g. "BG-16") — see
  /// src/lib/geo/bulgaria-regions.ts.
  regionCode        String
  regionName        String
  lat               Float
  lon               Float
  /// PUBLIC blurb — sanitized plaintext, NOT encrypted.
  description       String?
  /// Opt-in public seller name (a tenant may stay anonymous).
  sellerDisplayName String?
  status            ExchangeListingStatus @default(ACTIVE)
  expiresAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  inquiries ExchangeInquiry[]

  @@index([sellerTenantId])
  @@index([side, status])
  @@index([regionCode])
  @@index([status, expiresAt])
}

/// Cross-tenant inquiry against an ExchangeListing. No `tenantId` column, so
/// the DMMF auto-enroller leaves it out of TENANT_SCOPED_MODELS — but it IS
/// RLS-protected, on a parallel axis keyed on `inquirerTenantId` with the
/// seller reached through the listing (migration
/// 20260728120000_exchange_inquiry_rls). Written by a tenant OTHER than the
/// listing seller (the usecase forbids inquiring on your own listing).
///
/// `message` is sanitized plaintext and deliberately NOT encrypted. Two
/// reasons, both structural: the Epic B manifest keys by FIELD NAME, and
/// `message` is carried by Notification / ExchangeInquiry / InsuranceLead /
/// PromotionLead — adding `PromotionLead: ['message']` once already wrote
/// ciphertext into this very column (see
/// tests/unit/encryption-fanout-model-resolution.test.ts, which pins all four
/// out). And the per-tenant DEK model assumes ONE owning tenant, which a
/// two-party row does not have. PromotionLead.requestMessage is encryptable
/// precisely because that name is unique to it.
model ExchangeInquiry {
  id               String                @id @default(cuid())
  listingId        String
  /// Inquiring tenant — plain FK to Tenant.id (NOT a tenantId RLS column).
  inquirerTenantId String
  inquirerUserId   String
  message          String
  quantityTonnes   Decimal?              @db.Decimal(14, 3)
  status           ExchangeInquiryStatus @default(PENDING)
  createdAt        DateTime              @default(now())

  listing ExchangeListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // A tenant may express interest in a given listing at most once — the
  // dedup guard against repeat-inquiry spam. The usecase catches the
  // violation (P2002) and surfaces a friendly conflict.
  @@unique([listingId, inquirerTenantId])
  @@index([listingId])
  @@index([inquirerTenantId])
}
