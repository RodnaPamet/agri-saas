/// Insurance quote requests from the per-parcel Risk page (#13), opened by the
/// "Request insurance quote" button and priced by the calculator (#1120).
///
/// Lead-gen only — no insurer API. Like `PromotionLead` / `ExchangeInquiry`,
/// `inquirerTenantId` is a PLAIN FK to Tenant.id (NOT a tenantId RLS column),
/// so the row is not tenant-scoped and needs no RLS.
///
/// SEVERAL requests per parcel are allowed. This docblock used to say the
/// `@@unique` capped a tenant to one open request per parcel; that unique —
/// `([parcelId, inquirerTenantId])` — was DROPPED on 2026-09-24 so a farmer
/// could re-ask with a corrected land size. The remaining unique is on
/// `([inquirerTenantId, clientMutationId])` and does something different: it
/// collapses a RETRY of the same request without refusing a new one.
model InsuranceLead {
  id               String   @id @default(cuid())
  /// Requesting tenant — plain FK to Tenant.id (NOT a tenantId RLS column).
  inquirerTenantId String
  inquirerUserId   String
  /// The parcel the quote is about (free-form id, no FK — mirrors PromotionLead).
  parcelId         String
  locationId       String?
  message          String
  /// Snapshot of the parcel's satellite risk at request time (level/ndvi/ndmi).
  riskJson         Json?
  /// Curated status: "PENDING" | "CONTACTED" | "CLOSED".
  status           String   @default("PENDING")
  /// The premium quote as the SERVER computed it, snapshotted at request time:
  /// engineVersion, productKey, productKind, tariffBp, areaDca,
  /// sumInsuredCents, premiumCents, instalmentsCents, the two per-dca figures,
  /// currencySymbol and computedAt.
  ///
  /// Nothing recomputes it on read. A later tariff change must never rewrite
  /// what the farmer was actually shown, and `engineVersion` ties the stored
  /// figures to the rounding rules that produced them.
  quoteJson        Json?
  /// Idempotency-Key from the client, so a lost response and a retry make ONE
  /// lead and ONE operator email. Same shape as
  /// `ExchangeMessage.clientMutationId`.
  clientMutationId String?
  createdAt        DateTime @default(now())

  /// NO unique on (parcelId, inquirerTenantId).
  ///
  /// There was one until 2026-09-24, making an ask once-only per parcel with
  /// no withdraw and no edit — a second POST 409'd. The owner chose to allow
  /// several asks so a farmer can re-ask with a corrected land size, which the
  /// insurance form now collects.
  ///
  /// The cost of that choice is the operator's: a parcel can generate repeat
  /// leads that have to be reconciled by hand. It is deliberate, and the
  /// alternative (editing a lead in place) was rejected because a revision to
  /// a record already actioned is worse than a second record.
  ///
  /// `listInquiredParcelIds` still reports which parcels have been asked
  /// about, but it is now INFORMATIONAL — clients must not use it to disable
  /// the control, or re-asking is impossible.
  /// Postgres treats NULLs as DISTINCT, so leads posted without a key (the
  /// old bundle, and any client that omits the header) never collide here.
  @@unique([inquirerTenantId, clientMutationId])
  /// The access path the dropped unique used to provide.
  @@index([parcelId, inquirerTenantId])
  @@index([inquirerTenantId])
  @@index([parcelId])
}
